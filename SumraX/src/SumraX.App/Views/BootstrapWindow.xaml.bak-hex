<Window x:Class="SumraX.App.Views.BootstrapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:SumraX.App.Views.Controls"
        Title="Sumrak VPN"
        Width="360" Height="220"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True">
    <Window.Resources>
        <Storyboard x:Key="BootStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="RingOuter"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                             From="0" To="360" Duration="0:0:3.6"/>
            <DoubleAnimation Storyboard.TargetName="LogoGlow"
                             Storyboard.TargetProperty="Opacity"
                             From="0.25" To="0.7" Duration="0:0:1.2" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="BorderGlow"
                             Storyboard.TargetProperty="Opacity"
                             From="0.35" To="0.85" Duration="0:0:1.5" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="Shimmer"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="-60" To="360" Duration="0:0:1.8" AutoReverse="False"/>
        </Storyboard>
    </Window.Resources>

    <Border x:Name="RootBorder" Padding="18,16" CornerRadius="8"
            Background="#111112" BorderBrush="#FFD400" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#FFD400" BlurRadius="18" ShadowDepth="0" Opacity="0.28"/>
        </Border.Effect>
        <Grid>
            <Border x:Name="BorderGlow" BorderBrush="#A8E05F" BorderThickness="1" CornerRadius="8" Opacity="0.4" Margin="-1"/>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="44" Height="44" Margin="0,0,12,0">
                        <Ellipse x:Name="RingOuter" Width="44" Height="44" Stroke="#FFD400" StrokeThickness="1.2"
                                 StrokeDashArray="2 3" Opacity="0.65">
                            <Ellipse.RenderTransform>
                                <RotateTransform CenterX="22" CenterY="22"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="LogoGlow" Width="28" Height="28" Opacity="0.4">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#A8E05F" Offset="0"/>
                                    <GradientStop Color="#FFC4009A" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <ctrl:CyberLogo Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Sumrak VPN" FontFamily="JetBrains Mono, Consolas" FontSize="15" FontWeight="Bold" Foreground="#A8E05F"/>
                        <TextBlock x:Name="PhaseText" Text="PHASE 01 / BOOT" FontFamily="JetBrains Mono, Consolas" FontSize="8"
                                   Foreground="#B4B4AA" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,12">
                    <TextBlock x:Name="StatusText" Text="Initializing..."
                               FontFamily="JetBrains Mono, Consolas" Foreground="#F2F2ED" FontSize="12"
                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    <TextBlock x:Name="DotsText" Text="" Visibility="Collapsed"/>
                    <TextBlock x:Name="LastLog" Text="" FontFamily="JetBrains Mono, Consolas" FontSize="9"
                               Foreground="#A8E05F" Opacity="0.75" HorizontalAlignment="Center" Margin="0,8,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- keep for code-behind compatibility; hidden -->
                <ScrollViewer x:Name="LogScroll" Visibility="Collapsed" Height="0">
                    <ItemsControl x:Name="BootLog"/>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="0,0,0,8">
                    <Border Height="3" Background="#161617" CornerRadius="2"/>
                    <Border x:Name="ProgressFill" Height="3" HorizontalAlignment="Left" CornerRadius="2" Width="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#A8E05F" Offset="0"/>
                                <GradientStop Color="#FFD400" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border x:Name="Shimmer" Width="36" Height="3" HorizontalAlignment="Left" Opacity="0.45" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#FFD40088" Offset="0"/>
                                <GradientStop Color="#FF8A009A" Offset="0.5"/>
                                <GradientStop Color="#FFD40088" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.RenderTransform>
                            <TranslateTransform X="-60"/>
                        </Border.RenderTransform>
                    </Border>
                </Grid>

                <Grid Grid.Row="3">
                    <TextBlock x:Name="PercentText" Text="0%" FontFamily="JetBrains Mono, Consolas" FontSize="9"
                               Foreground="#7A7A72" HorizontalAlignment="Left"/>
                    <TextBlock Text="sumrax://boot" FontFamily="JetBrains Mono, Consolas" FontSize="8"
                               Foreground="#2A2A2C" HorizontalAlignment="Right"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
