<UserControl x:Class="SumraX.App.Views.AiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SumraX.App.Converters">
    <UserControl.Resources>
        <conv:BoolToSpeakerConverter x:Key="Speaker"/>
        <conv:ChatBubbleStyleConverter x:Key="ChatBubble"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid Margin="28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource PageSubtitle}"/>
                <TextBlock Text="◉ NEURAL CORE ONLINE" FontFamily="{StaticResource MonoFont}" FontSize="11"
                           Foreground="{DynamicResource CyberPurpleBrush}" Margin="0,8,0,0"/>
            </StackPanel>
            <Button Content="{Binding ClearLabel}" Style="{StaticResource SecondaryButton}" Command="{Binding ClearCommand}"
                    HorizontalAlignment="Right" VerticalAlignment="Top"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource HudCard}" Padding="14" Background="{DynamicResource BgSecondaryBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{Binding IsUser, Converter={StaticResource ChatBubble}}">
                                <StackPanel>
                                    <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource NeonBlueBrush}"
                                               Text="{Binding IsUser, Converter={StaticResource Speaker}}"/>
                                    <TextBlock Text="{Binding Content}" FontFamily="{StaticResource PrimaryFont}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Margin="0,6,0,0" LineHeight="22" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource SearchBox}" Margin="0,0,10,0"/>
            <Button Grid.Column="1" Content="{Binding SendLabel}" Style="{StaticResource ConnectButton}"
                    Command="{Binding SendCommand}" Padding="20,12" FontSize="11"/>
        </Grid>
        <TextBlock Grid.Row="2" Text="{Binding ThinkingLabel}" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource CyberPurpleBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-18"
                   Visibility="{Binding IsThinking, Converter={StaticResource BoolToVis}}"/>
    </Grid>
</UserControl>
