<UserControl x:Class="SumraX.App.Views.ServerPickerOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SumraX.App.Converters"
             xmlns:vm="clr-namespace:SumraX.App.ViewModels"
             xmlns:ctrl="clr-namespace:SumraX.App.Views.Controls"
             Visibility="Collapsed"
             IsHitTestVisible="False">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:LocFormatConverter x:Key="LocFormat"/>
        <conv:IntEqualsConverter x:Key="IntEquals"/>
        <conv:ExpandChevronConverter x:Key="ExpandChevron"/>
        <conv:PingMsDisplayConverter x:Key="PingMsDisplay"/>
        <conv:ServerProtocolConverter x:Key="ServerProtocol"/>
        <Style x:Key="PickerTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource BgCardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgElevatedBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource NeonBlueBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PickerIconButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Padding" Value="7"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="MaxHeight" Value="32"/>
        </Style>
        <Style x:Key="PickerGlowCyan" TargetType="Button" BasedOn="{StaticResource PickerIconButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#FFD400"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FFD400" BlurRadius="14" ShadowDepth="0" Opacity="0.85"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="BorderBrush" Value="#FFD400"/>
                    <Setter Property="Background" Value="#FFB800FF"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FFD400" BlurRadius="20" ShadowDepth="0" Opacity="1"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PickerGlowPurple" TargetType="Button" BasedOn="{StaticResource PickerIconButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#FFA000"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FFA000" BlurRadius="14" ShadowDepth="0" Opacity="0.85"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="BorderBrush" Value="#FFA000"/>
                    <Setter Property="Background" Value="#6E8F3AFF"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FFA000" BlurRadius="20" ShadowDepth="0" Opacity="1"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PickerGlowAmber" TargetType="Button" BasedOn="{StaticResource PickerIconButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#FFB020"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FFB020" BlurRadius="14" ShadowDepth="0" Opacity="0.85"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="BorderBrush" Value="#FFB020"/>
                    <Setter Property="Background" Value="#FFB80020"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FFB020" BlurRadius="20" ShadowDepth="0" Opacity="1"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PickerGlowMagenta" TargetType="Button" BasedOn="{StaticResource PickerIconButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#FFB300"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FFB300" BlurRadius="14" ShadowDepth="0" Opacity="0.85"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="BorderBrush" Value="#FFB300"/>
                    <Setter Property="Background" Value="#FFD400D8"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FFB300" BlurRadius="20" ShadowDepth="0" Opacity="1"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PickerGlowGreen" TargetType="Button" BasedOn="{StaticResource PickerIconButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#FFD400"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FFD400" BlurRadius="14" ShadowDepth="0" Opacity="0.85"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="BorderBrush" Value="#FFD400"/>
                    <Setter Property="Background" Value="#FFC4009A"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FFD400" BlurRadius="20" ShadowDepth="0" Opacity="1"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PickerGlowBlue" TargetType="Button" BasedOn="{StaticResource PickerIconButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#FFD400"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FFD400" BlurRadius="14" ShadowDepth="0" Opacity="0.85"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="BorderBrush" Value="#FFD400"/>
                    <Setter Property="Background" Value="#FFC400FF"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FFD400" BlurRadius="20" ShadowDepth="0" Opacity="1"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root">
        <Border x:Name="Backdrop" Background="#E6000000" Opacity="1" MouseDown="Backdrop_MouseDown"/>

        <Border x:Name="Sheet"
                Width="400" MaxWidth="400"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,10"
                MaxHeight="480" MinHeight="340"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource NeonBlueBrush}" BorderThickness="1"
                CornerRadius="10" ClipToBounds="True">
            <Border.RenderTransform>
                <TranslateTransform x:Name="SheetTransform" Y="740"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Color="#FFD400" BlurRadius="18" ShadowDepth="0" Opacity="0.22"/>
            </Border.Effect>

            <Grid Margin="0,4,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Compact header -->
                <Grid Grid.Row="0" Margin="12,6,10,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ctrl:GlowIcon Kind="Globe" Tone="Blue" Width="15" Height="15" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Servers.PickerTitle}" FontFamily="{StaticResource MonoFont}"
                                   FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButton}" Command="{Binding Servers.RefreshSubscriptionsCommand}"
                                ToolTip="{Binding Servers.RefreshSubsLabel}" Width="28" Height="28" Padding="0" Margin="0,0,4,0">
                            <ctrl:GlowIcon Kind="Refresh" Tone="Green" Width="14" Height="14"/>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding Servers.TestAllCommand}"
                                ToolTip="{Binding Servers.TestAllLabel}" Width="28" Height="28" Padding="0" Margin="0,0,4,0">
                            <ctrl:GlowIcon Kind="Pulse" Tone="Blue" Width="14" Height="14"/>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding Servers.ImportLinkCommand}"
                                ToolTip="{Binding Servers.ImportLabel}" Width="28" Height="28" Padding="0" Margin="0,0,4,0">
                            <ctrl:GlowIcon Kind="Import" Tone="Amber" Width="14" Height="14"/>
                        </Button>
                        <Button Style="{StaticResource GhostButton}"
                                Command="{Binding CloseServerPickerCommand}" Width="28" Height="28" Padding="0">
                            <ctrl:GlowIcon Kind="Close" Tone="Blue" Width="12" Height="12"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Compact import toolbar -->
                <Border Grid.Row="1" Margin="10,0,10,6" Background="{DynamicResource BgCardBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="8,7">
                    <StackPanel>
                        <TextBox Text="{Binding Servers.ImportLink, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource SearchBox}" ToolTip="{Binding Servers.ImportTooltip}"
                                 FontSize="12" Padding="8,6" Margin="0,0,0,6" Height="30"/>
                        <StackPanel Orientation="Horizontal">
                            <!-- Import strip: paste → import → QR -->
                            <Button Style="{StaticResource PickerGlowCyan}" Command="{Binding Servers.PasteAndImportCommand}"
                                    ToolTip="{Binding Servers.PasteLabel}" Margin="0,0,5,0">
                                <ctrl:GlowIcon Kind="Paste" Tone="Cyan" Width="14" Height="14"/>
                            </Button>
                            <Button Style="{StaticResource PickerGlowAmber}" Command="{Binding Servers.ImportLinkCommand}"
                                    ToolTip="{Binding Servers.ImportLabel}" Margin="0,0,5,0">
                                <ctrl:GlowIcon Kind="Import" Tone="Amber" Width="14" Height="14"/>
                            </Button>
                            <Button Style="{StaticResource PickerGlowPurple}" Command="{Binding Servers.ImportQrCommand}"
                                    ToolTip="{Binding Servers.QrLabel}" Margin="0,0,5,0">
                                <ctrl:GlowIcon Kind="Qr" Tone="Purple" Width="14" Height="14"/>
                            </Button>
                            <Button Style="{StaticResource PickerGlowAmber}" Command="{Binding Servers.ImportFileCommand}"
                                    ToolTip="{Binding Servers.FileLabel}">
                                <ctrl:GlowIcon Kind="File" Tone="Amber" Width="14" Height="14"/>
                            </Button>
                            <Button Style="{StaticResource PickerGlowMagenta}" Command="{Binding Servers.AddManualCommand}"
                                    ToolTip="{Binding Servers.ManualLabel}">
                                <ctrl:GlowIcon Kind="Edit" Tone="Magenta" Width="14" Height="14"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Mini filter tabs -->
                <StackPanel Grid.Row="2" Margin="12,0,12,6">
                    <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource PickerTab}" GroupName="PickerFilter"
                                 IsChecked="{Binding Servers.FilterMode, Converter={StaticResource IntEquals}, ConverterParameter=0, Mode=OneWay}"
                                 Command="{Binding Servers.SetPickerFilterCommand}" CommandParameter="0"
                                 ToolTip="{Binding Servers.PickerTabPlaces}">
                        <StackPanel Orientation="Horizontal">
                            <ctrl:GlowIcon Kind="Places" Tone="Blue" Width="11" Height="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Servers.PickerTabPlaces}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource PickerTab}" GroupName="PickerFilter"
                                 IsChecked="{Binding Servers.FilterMode, Converter={StaticResource IntEquals}, ConverterParameter=1, Mode=OneWay}"
                                 Command="{Binding Servers.SetPickerFilterCommand}" CommandParameter="1"
                                 ToolTip="{Binding Servers.PickerTabFavorites}">
                        <StackPanel Orientation="Horizontal">
                            <ctrl:GlowIcon Kind="Star" Tone="Green" Width="11" Height="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Servers.PickerTabFavorites}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource PickerTab}" GroupName="PickerFilter"
                                 IsChecked="{Binding Servers.FilterMode, Converter={StaticResource IntEquals}, ConverterParameter=2, Mode=OneWay}"
                                 Command="{Binding Servers.SetPickerFilterCommand}" CommandParameter="2"
                                 ToolTip="{Binding Servers.PickerTabRecent}">
                        <StackPanel Orientation="Horizontal">
                            <ctrl:GlowIcon Kind="Clock" Tone="Blue" Width="11" Height="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Servers.PickerTabRecent}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    </StackPanel>

                    <!-- Sort: smart ranking first, then the classic keys -->
                    <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding Servers.SortLabel}" VerticalAlignment="Center" Margin="0,0,8,0"
                                   FontFamily="{StaticResource PrimaryFont}" FontSize="10" FontWeight="SemiBold" Opacity="0.6"/>
                        <RadioButton Style="{StaticResource PickerTab}" Content="{Binding Servers.PickerTabSmart}"
                                     GroupName="PickerSort"
                                     IsChecked="{Binding Servers.SortMode, Converter={StaticResource IntEquals}, ConverterParameter=0, Mode=OneWay}"
                                     Command="{Binding Servers.SetPickerSortCommand}" CommandParameter="0"
                                     ToolTip="{Binding Servers.PickerTabSmart}"/>
                        <RadioButton Style="{StaticResource PickerTab}" Content="{Binding Servers.PickerTabPing}"
                                     GroupName="PickerSort"
                                     IsChecked="{Binding Servers.SortMode, Converter={StaticResource IntEquals}, ConverterParameter=1, Mode=OneWay}"
                                     Command="{Binding Servers.SetPickerSortCommand}" CommandParameter="1"
                                     ToolTip="{Binding Servers.PickerTabPing}"/>
                        <RadioButton Style="{StaticResource PickerTab}" Content="{Binding Servers.PickerTabName}"
                                     GroupName="PickerSort"
                                     IsChecked="{Binding Servers.SortMode, Converter={StaticResource IntEquals}, ConverterParameter=2, Mode=OneWay}"
                                     Command="{Binding Servers.SetPickerSortCommand}" CommandParameter="2"
                                     ToolTip="{Binding Servers.PickerTabName}"/>
                        <RadioButton Style="{StaticResource PickerTab}" Content="{Binding Servers.PickerTabLoad}"
                                     GroupName="PickerSort"
                                     IsChecked="{Binding Servers.SortMode, Converter={StaticResource IntEquals}, ConverterParameter=3, Mode=OneWay}"
                                     Command="{Binding Servers.SetPickerSortCommand}" CommandParameter="3"
                                     ToolTip="{Binding Servers.PickerTabLoad}"/>
                    </WrapPanel>
                </StackPanel>

                <TextBlock Grid.Row="3" Text="{Binding Servers.StatusMessage}" FontFamily="{StaticResource MonoFont}"
                           Foreground="{DynamicResource NeonBlueBrush}" FontSize="12" FontWeight="SemiBold" Margin="12,0,12,4"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="28"/>

                <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Padding="8,0,8,10">
                    <ItemsControl ItemsSource="{Binding Servers.CountryGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ServerCountryGroup}">
                                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                        CornerRadius="6" Margin="4,0,4,6" Padding="8,7">
                                    <StackPanel>
                                        <Button Style="{StaticResource GhostButton}" Padding="0" HorizontalContentAlignment="Stretch"
                                                Command="{Binding DataContext.Servers.ToggleCountryGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding FlagEmoji}" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CountryName}" FontFamily="{StaticResource MonoFont}"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0">
                                                        <TextBlock.Text>
                                                            <Binding Path="ServerCount" Converter="{StaticResource LocFormat}" ConverterParameter="PlacesCountFormat"/>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Border Grid.Column="2" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"
                                                        Background="{DynamicResource SurfaceHoverBrush}" BorderBrush="{DynamicResource NeonGreenBrush}" BorderThickness="1"
                                                        CornerRadius="8" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="5" Height="5" Fill="{DynamicResource NeonGreenBrush}" Margin="0,0,4,0"/>
                                                        <TextBlock Text="{Binding DataContext.Servers.ActiveBadgeLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                   FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold"
                                                                   Foreground="{DynamicResource NeonGreenBrush}"/>
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Grid.Column="3" Text="{Binding IsExpanded, Converter={StaticResource ExpandChevron}}"
                                                           FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                           FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>

                                        <ItemsControl ItemsSource="{Binding Servers}" Margin="0,6,0,0"
                                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource GhostButton}" Padding="6,5" Margin="0,0,0,2"
                                                            HorizontalContentAlignment="Stretch"
                                                            Command="{Binding DataContext.Servers.PickServerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" HorizontalAlignment="Left">
                                                                <TextBlock Text="{Binding DisplayName}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                                           FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding ., Converter={StaticResource ServerProtocol}}" FontSize="10"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0"
                                                                       Text="{Binding PingMs, Converter={StaticResource PingMsDisplay}}"/>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
