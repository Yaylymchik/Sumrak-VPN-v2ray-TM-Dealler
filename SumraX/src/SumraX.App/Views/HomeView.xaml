<UserControl x:Class="SumraX.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SumraX.App.Converters"
             xmlns:ctrl="clr-namespace:SumraX.App.Views.Controls"
             xmlns:vm="clr-namespace:SumraX.App.ViewModels">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolConverter x:Key="InverseBool"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolVis"/>
        <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyVisibility"/>
        <conv:ExpandChevronConverter x:Key="ExpandChevron"/>
        <conv:PingMsDisplayConverter x:Key="PingMsDisplay"/>
        <conv:ServerProtocolConverter x:Key="ServerProtocol"/>
        <conv:ServerSelectedConverter x:Key="ServerSelected"/>
        <conv:CountryFlagConverter x:Key="CountryFlag"/>
        <Storyboard x:Key="BlockServiceIn">
            <DoubleAnimation Storyboard.TargetName="BlockServiceBanner" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.35"/>
        </Storyboard>
        <Storyboard x:Key="BlockServiceOut">
            <DoubleAnimation Storyboard.TargetName="BlockServiceBanner" Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.22"/>
        </Storyboard>
        <Storyboard x:Key="BlockServicePulse" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="RenewGlow" Storyboard.TargetProperty="Opacity"
                             From="0.25" To="0.55" Duration="0:0:2" AutoReverse="True"/>
        </Storyboard>
    </UserControl.Resources>

    <Grid Margin="12,8,12,0" MaxWidth="460">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="BlockServiceBanner" Grid.Row="0" Margin="0,0,0,6" Opacity="0" CornerRadius="6"
                Visibility="{Binding ShowBlockServiceToast, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource BgCardBrush}" BorderBrush="#FFD400" BorderThickness="1" Padding="10,8">
            <Border.Effect>
                <DropShadowEffect x:Name="RenewGlow" Color="#FFD400" BlurRadius="10" ShadowDepth="0" Opacity="0.35"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="{Binding BlockServiceTitle}" FontWeight="Bold" FontSize="12" Foreground="#FFD400" TextAlignment="Center"/>
                <TextBlock Text="{Binding BlockServiceSubtitle}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                           TextAlignment="Center" Visibility="{Binding BlockServiceSubtitle, Converter={StaticResource StringNotEmptyVisibility}}"/>
            </StackPanel>
        </Border>

        <!-- Toolbar: settings | + -->
        <Grid Grid.Row="1" Margin="0,0,0,4">
            <Button Style="{StaticResource GhostButton}" Padding="6" Width="36" Height="36" HorizontalAlignment="Left"
                    Command="{Binding DataContext.OpenSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    ToolTip="{Binding DataContext.NavSettings, RelativeSource={RelativeSource AncestorType=Window}}">
                <ctrl:GlowIcon Kind="Settings" Tone="Amber" Width="18" Height="18"/>
            </Button>
            <Button x:Name="HomeAddButton" Style="{StaticResource GhostButton}" Padding="6" Width="36" Height="36"
                    HorizontalAlignment="Right" Click="HomeAddButton_Click">
                <TextBlock Text="+" FontSize="20" FontWeight="Bold" Foreground="#FFD400"/>
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{Binding HomeAddSubscriptionLabel}"
                                  Command="{Binding OpenHomeAddSubscriptionCommand}"/>
                        <MenuItem Header="{Binding Servers.PasteLabel}"
                                  Command="{Binding Servers.PasteAndImportCommand}"/>
                        <MenuItem Header="{Binding Servers.QrLabel}"
                                  Command="{Binding Servers.ImportQrCommand}"/>
                        <MenuItem Header="{Binding Servers.ManualLabel}"
                                  Command="{Binding Servers.AddManualCommand}"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </Grid>

        <ctrl:SegmentedModeSwitch Grid.Row="2" Margin="0,0,0,6"
                                  IsTunMode="{Binding IsSmartMode, Converter={StaticResource InverseBool}, Mode=TwoWay}"
                                  LeftLabel="{Binding ConnectionModeSmartLabel}"
                                  RightLabel="{Binding ConnectionModeManualLabel}"
                                  HorizontalAlignment="Center" MaxWidth="280"/>

        <TextBlock Grid.Row="3" Text="{Binding SubscriptionRenewalBanner}"
                   Visibility="{Binding SubscriptionRenewalBanner, Converter={StaticResource StringNotEmptyVisibility}}"
                   FontFamily="{StaticResource PrimaryFont}" FontSize="11" FontWeight="Bold"
                   Foreground="#FF6B6B" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,4"/>

        <!-- Power -->
        <StackPanel Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Center">
            <ctrl:SumrakPowerButton Command="{Binding ToggleConnectionCommand}"
                                  IsConnected="{Binding IsPowerOn}"
                                  IsConnecting="{Binding IsConnecting}"
                                  HorizontalAlignment="Center" Margin="0,0,0,6"/>
            <TextBlock Text="{Binding StatusText}" TextAlignment="Center"
                       FontFamily="{StaticResource PrimaryFont}" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,2"
                       Visibility="{Binding ShowHomeStatusText, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}"
                       FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="8,4,8,0"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyVisibility}}"/>
        </StackPanel>

        <!-- List zone: hide-all on right, groups below power -->
        <Grid Grid.Row="5" Margin="0,4,0,0">
            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Padding="12,6" Margin="0,0,0,4" Command="{Binding ToggleServersListHiddenCommand}"
                    Visibility="{Binding HasServers, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding HideAllLabel}" FontSize="11" Opacity="0.65"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Button>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,28,0,4" Margin="0,0,0,0"
                          Visibility="{Binding HasServers, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <StackPanel Visibility="{Binding ServersListHidden, Converter={StaticResource InverseBoolVis}}">
                        <ItemsControl ItemsSource="{Binding DataContext.Servers.HomeGroups, RelativeSource={RelativeSource AncestorType=Window}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ServerSubscriptionGroup}">
                                    <Border Background="{DynamicResource BgCardBrush}" CornerRadius="8" Margin="0,0,0,6"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Padding="0,2,4,4">
                                        <StackPanel>
                                            <Grid Margin="0,2,0,0" MinHeight="48" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Style="{StaticResource GhostButton}" Width="48" Height="48" Padding="0"
                                                        VerticalAlignment="Stretch"
                                                        Command="{Binding DataContext.Servers.ToggleHomeGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="{Binding IsExpanded, Converter={StaticResource ExpandChevron}}"
                                                               FontSize="12" FontWeight="Bold"/>
                                                </Button>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,4,0">
                                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               Visibility="{Binding Subtitle, Converter={StaticResource StringNotEmptyVisibility}}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource GhostButton}" Width="40" Height="40" Padding="0"
                                                        Command="{Binding DataContext.Servers.RefreshHomeGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding GroupKey}"
                                                        ToolTip="{Binding DataContext.Servers.RefreshSubsLabel, RelativeSource={RelativeSource AncestorType=Window}}">
                                                    <ctrl:GlowIcon Kind="Refresh" Tone="Amber" Width="16" Height="16"/>
                                                </Button>
                                                <Button Style="{StaticResource GhostButton}" Width="40" Height="40" Padding="0"
                                                        Command="{Binding DataContext.Servers.PingHomeGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding GroupKey}"
                                                        ToolTip="{Binding DataContext.Servers.TestAllLabel, RelativeSource={RelativeSource AncestorType=Window}}">
                                                    <ctrl:GlowIcon Kind="Pulse" Tone="Cyan" Width="16" Height="16"/>
                                                </Button>
                                                <Button Style="{StaticResource GhostButton}" Width="40" Height="40" Padding="0"
                                                        Tag="{Binding GroupKey}" ToolTip="⋯"
                                                        Click="HomeGroupMoreButton_Click">
                                                    <ctrl:GlowIcon Kind="More" Tone="Amber" Width="16" Height="16"/>
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="{Binding Servers.GroupMenuSettingsLabel}"
                                                                      Command="{Binding Servers.OpenGroupSettingsCommand}"
                                                                      CommandParameter="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                                <MenuItem.Style>
                                                                    <Style TargetType="MenuItem" BasedOn="{StaticResource SumraxMenuItem}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </MenuItem.Style>
                                                            </MenuItem>
                                                            <MenuItem Header="{Binding Servers.GroupMenuPingSettingsLabel}"
                                                                      Command="{Binding Servers.OpenGroupPingSettingsCommand}"
                                                                      CommandParameter="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                                <MenuItem.Style>
                                                                    <Style TargetType="MenuItem" BasedOn="{StaticResource SumraxMenuItem}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </MenuItem.Style>
                                                            </MenuItem>
                                                            <MenuItem Header="{Binding Servers.GroupMenuRoutingLabel}"
                                                                      Command="{Binding Servers.OpenGroupRoutingCommand}"/>
                                                            <Separator/>
                                                            <MenuItem Header="{Binding Servers.RefreshSubsLabel}"
                                                                      Command="{Binding Servers.RefreshHomeGroupCommand}"
                                                                      CommandParameter="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                            <MenuItem Header="{Binding Servers.TestAllLabel}"
                                                                      Command="{Binding Servers.PingHomeGroupCommand}"
                                                                      CommandParameter="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                            <MenuItem Header="{Binding Servers.GroupMenuPinLabel}"
                                                                      Command="{Binding Servers.TogglePinHomeGroupCommand}"
                                                                      CommandParameter="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                            <Separator/>
                                                            <MenuItem Header="{Binding Servers.GroupMenuDeleteLabel}"
                                                                      Command="{Binding Servers.DeleteHomeGroupCommand}"
                                                                      CommandParameter="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                                </StackPanel>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Servers}" Margin="4,0,0,2"
                                                          Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource GhostButton}" Padding="6,6" Margin="0,0,0,1"
                                                                HorizontalContentAlignment="Stretch"
                                                                Command="{Binding DataContext.Servers.PickServerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="4"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0" Width="4" CornerRadius="2" Margin="0,4,0,4"
                                                                        Background="#FFD400">
                                                                    <Border.Visibility>
                                                                        <MultiBinding Converter="{StaticResource ServerSelected}">
                                                                            <Binding Path="Id"/>
                                                                            <Binding Path="DataContext.Servers.SelectedServerId"
                                                                                     RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                        </MultiBinding>
                                                                    </Border.Visibility>
                                                                </Border>
                                                                <TextBlock Grid.Column="1" FontSize="16" Margin="6,0,8,0"
                                                                           VerticalAlignment="Center"
                                                                           Text="{Binding CountryCode, Converter={StaticResource CountryFlag}}"/>
                                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                                                               Text="{Binding ., Converter={StaticResource ServerProtocol}}"/>
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="3" Text="{Binding PingMs, Converter={StaticResource PingMsDisplay}}"
                                                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                                                           VerticalAlignment="Center" Margin="8,0,4,0"/>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <StackPanel VerticalAlignment="Bottom" Margin="8,0,8,8"
                        Visibility="{Binding HasServers, Converter={StaticResource InverseBoolVis}}">
                <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Center" Margin="0,0,0,8"
                        Command="{Binding CopyHwidCommand}" Padding="10,6">
                    <StackPanel Orientation="Horizontal">
                        <ctrl:GlowIcon Kind="Paste" Tone="Cyan" Width="12" Height="12" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding HwidDisplay}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Center" Margin="0,0,0,8"
                        Command="{Binding DataContext.OpenAiCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                    <StackPanel Orientation="Horizontal">
                        <ctrl:GlowIcon Kind="Ai" Tone="Amber" Width="14" Height="14" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding HomeAiLabel}" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding HomeEmptyHint}" TextAlignment="Center" TextWrapping="Wrap"
                           FontFamily="{StaticResource PrimaryFont}" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                <UniformGrid Columns="2" Margin="0,0,0,4">
                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,4,0" Padding="8,6"
                            Command="{Binding DataContext.Servers.PasteAndImportCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ctrl:GlowIcon Kind="Paste" Tone="Cyan" Width="14" Height="14" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding DataContext.Servers.PasteLabel, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="11"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Margin="4,0,0,0" Padding="8,6"
                            Command="{Binding DataContext.Servers.ImportQrCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ctrl:GlowIcon Kind="Qr" Tone="Purple" Width="14" Height="14" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding DataContext.Servers.QrLabel, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="11"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="6" HorizontalAlignment="Center" Margin="0,4,0,10"
                    Visibility="{Binding HasServers, Converter={StaticResource InverseBoolVis}}">
            <TextBlock Text="{Binding HomeBrandCoder}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" Opacity="0.6"/>
            <TextBlock Text="{Binding HomeBrandName}" FontSize="16" FontWeight="Bold" Foreground="#FFD400"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>