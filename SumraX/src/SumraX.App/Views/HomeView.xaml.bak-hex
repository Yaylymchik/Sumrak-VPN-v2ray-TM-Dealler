<UserControl x:Class="SumraX.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SumraX.App.Converters"
             xmlns:ctrl="clr-namespace:SumraX.App.Views.Controls">
    <UserControl.Resources>
        <conv:ConnectionStateToStatusBadgeConverter x:Key="StatusBadge"/>
        <conv:ConnectionStateToStatusTextBrushConverter x:Key="StatusTextBrush"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolConverter x:Key="InverseBool"/>
        <conv:BoolToConnectButtonStyleConverter x:Key="ConnectBtnStyle"/>
        <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyVisibility"/>

        <Storyboard x:Key="BlockServiceIn">
            <DoubleAnimation Storyboard.TargetName="BlockServiceBanner" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="BlockServiceSlide" Storyboard.TargetProperty="Y"
                             From="-8" To="0" Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="BlockServiceOut">
            <DoubleAnimation Storyboard.TargetName="BlockServiceBanner" Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.22">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="BlockServicePulse" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="BrandGlow" Storyboard.TargetProperty="Opacity"
                             From="0.2" To="0.45" Duration="0:0:2" AutoReverse="True"/>
        </Storyboard>
    </UserControl.Resources>

    <Grid Margin="18,10,18,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Brand strip — same language as HudCard / neon UI -->
        <Border x:Name="BlockServiceBanner" Grid.Row="0"
                HorizontalAlignment="Stretch" MaxWidth="440"
                Margin="0,0,0,10" Opacity="0"
                Visibility="{Binding ShowBlockServiceToast, Converter={StaticResource BoolToVis}}">
            <Border.RenderTransform>
                <TranslateTransform x:Name="BlockServiceSlide" Y="0"/>
            </Border.RenderTransform>
            <Border Style="{StaticResource HudCard}" Padding="14,11" CornerRadius="6">
                <Border.Effect>
                    <DropShadowEffect x:Name="BrandGlow" Color="#FFD400" BlurRadius="12" ShadowDepth="0" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding BlockServiceTitle}" FontFamily="{StaticResource MonoFont}"
                               FontSize="14" FontWeight="Bold" Foreground="{DynamicResource NeonBlueBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding BlockServiceSubtitle}" FontFamily="{StaticResource PrimaryFont}"
                               FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource HudCard}" Padding="16,14"
                VerticalAlignment="Center" HorizontalAlignment="Stretch"
                MaxWidth="440" CornerRadius="8">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="// PROFILE" FontFamily="{StaticResource MonoFont}" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource NeonBlueBrush}" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Style="{Binding State, Converter={StaticResource StatusBadge}}"
                            Padding="8,4" HorizontalAlignment="Right" CornerRadius="4">
                        <TextBlock Text="{Binding StatusText}" FontFamily="{StaticResource MonoFont}" FontSize="9" FontWeight="Bold"
                                   Foreground="{Binding State, Converter={StaticResource StatusTextBrush}}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                    </Border>
                </Grid>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding IpLabel}" Style="{StaticResource StatLabel}" FontSize="10" Margin="0,3"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding PublicIp}" Style="{StaticResource StatValue}" FontSize="11" HorizontalAlignment="Right" Margin="0,3"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding LocationLabel}" Style="{StaticResource StatLabel}" FontSize="10" Margin="0,3"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Country}" Style="{StaticResource StatValue}" FontSize="11" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="0,3"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding PingLabel}" Style="{StaticResource StatLabel}" FontSize="10" Margin="0,3"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding PingDisplay}" Style="{StaticResource StatValue}" FontSize="11" HorizontalAlignment="Right" Margin="0,3"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding EncryptionLabel}" Style="{StaticResource StatLabel}" FontSize="10" Margin="0,3"/>
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding EncryptionDisplay}" Style="{StaticResource StatValue}" FontSize="11" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="0,3"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding DurationLabel}" Style="{StaticResource StatLabel}" FontSize="10" Margin="0,3"/>
                    <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding DurationDisplay}" Style="{StaticResource StatValue}" FontSize="11" HorizontalAlignment="Right" Margin="0,3"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding TrafficLabel}" Style="{StaticResource StatLabel}" FontSize="10" Margin="0,3"/>
                    <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding TrafficDisplay}" Style="{StaticResource StatValue}" FontSize="11" HorizontalAlignment="Right" Margin="0,3"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding CoreLabel}" Style="{StaticResource StatLabel}" FontSize="10" Margin="0,3"/>
                    <TextBlock Grid.Row="6" Grid.Column="2" Text="{Binding CoreDisplay}" Style="{StaticResource StatValue}" FontSize="11" HorizontalAlignment="Right" Margin="0,3"/>
                </Grid>

                <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Opacity="0.45" Margin="0,0,0,12"/>

                <StackPanel Margin="0,0,0,10">
                    <ctrl:SegmentedModeSwitch IsTunMode="{Binding IsSmartMode, Converter={StaticResource InverseBool}, Mode=TwoWay}"
                                              LeftLabel="{Binding ConnectionModeSmartLabel}"
                                              RightLabel="{Binding ConnectionModeManualLabel}"
                                              Margin="0,0,0,6"
                                              HorizontalAlignment="Stretch"/>
                    <ctrl:SegmentedModeSwitch IsTunMode="{Binding UseTunMode, Mode=TwoWay}"
                                              LeftLabel="{Binding ConnectionModeProxyLabel}"
                                              RightLabel="{Binding ConnectionModeTunLabel}"
                                              HorizontalAlignment="Stretch"/>
                </StackPanel>

                <Button Command="{Binding ToggleConnectionCommand}"
                        Style="{Binding State, Converter={StaticResource ConnectBtnStyle}}"
                        HorizontalAlignment="Stretch" Padding="10,10" FontSize="13">
                    <TextBlock Text="{Binding ConnectButtonText}" TextAlignment="Center" FontWeight="Bold"/>
                </Button>

                <TextBlock Text="{Binding ConnectionStateLabel}" FontFamily="{StaticResource MonoFont}"
                           Foreground="{DynamicResource NeonBlueBrush}" FontSize="9" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,6,0,0"
                           Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVis}}"/>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}"
                           FontFamily="{StaticResource PrimaryFont}" FontSize="10" FontWeight="SemiBold"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyVisibility}}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Padding="0,10,0,12" Margin="0,4,0,0"
                MaxWidth="440" HorizontalAlignment="Stretch">
            <Button Style="{StaticResource GhostButton}" Padding="0" HorizontalContentAlignment="Stretch"
                    Command="{Binding DataContext.OpenServersCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                <Border Background="{DynamicResource BgCardBrush}" CornerRadius="6" Padding="12,9"
                        BorderBrush="{DynamicResource NeonBlueBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding CountryFlag}" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectServerLabel}" FontFamily="{StaticResource MonoFont}" FontSize="8" FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding ServerDisplayName}" FontFamily="{StaticResource PrimaryFont}" FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="›" FontFamily="{StaticResource MonoFont}" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource NeonBlueBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                </Border>
            </Button>
        </Border>
    </Grid>
</UserControl>
