<UserControl x:Class="SumraX.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SumraX.App.Converters"
             xmlns:vm="clr-namespace:SumraX.App.ViewModels"
             xmlns:ctrl="clr-namespace:SumraX.App.Views.Controls">
    <UserControl.Resources>
        <conv:LanguageDisplayConverter x:Key="LanguageDisplay"/>
        <conv:ThemeDisplayConverter x:Key="ThemeDisplay"/>
        <conv:TunStackModeDisplayConverter x:Key="TunStackDisplay"/>
        <conv:TunProviderDisplayConverter x:Key="TunProviderDisplay"/>
        <conv:ClientUserAgentDisplayConverter x:Key="UserAgentDisplay"/>
        <conv:PingTypeDisplayConverter x:Key="PingTypeDisplay"/>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <DataTemplate x:Key="HubRowTemplate" DataType="{x:Type vm:SettingsHubRowViewModel}">
            <Button Style="{StaticResource SecondaryButton}" Margin="0,0,0,1" Padding="12,10" HorizontalContentAlignment="Stretch"
                    Focusable="False" FocusVisualStyle="{x:Null}"
                    Command="{Binding DataContext.OpenHubRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Title}" FontFamily="{StaticResource PrimaryFont}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDanger}" Value="True">
                                        <Setter Property="Foreground" Value="#FF5C5C"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="1" Text="›" Foreground="#FFD400" FontSize="16" VerticalAlignment="Center"/>
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
        <StackPanel MaxWidth="440">
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="{Binding BackLabel}" Style="{StaticResource SecondaryButton}"
                        Command="{Binding NavigateBackCommand}" Margin="0,0,8,0" Padding="10,5"
                        Visibility="{Binding IsDetailSection, Converter={StaticResource BoolVis}}"/>
                <TextBlock Grid.Column="1" Text="{Binding SectionTitle}" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock Text="{Binding UpdateMessage}" FontFamily="{StaticResource PrimaryFont}" Foreground="{DynamicResource NeonGreenBrush}"
                       TextWrapping="Wrap" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,10"/>

            <!-- ROOT — scroll hub (UI → Tunnel → Advanced → Other → About) -->
            <StackPanel Visibility="{Binding IsRootSection, Converter={StaticResource BoolVis}}">

                <TextBlock Text="{Binding HubUiLabel}" FontFamily="{StaticResource PrimaryFont}" FontSize="14" FontWeight="Bold"
                           Foreground="#FFD400" Margin="4,0,0,6"/>
                <ItemsControl ItemsSource="{Binding HubUiRows}" ItemTemplate="{StaticResource HubRowTemplate}"/>

                <TextBlock Text="{Binding HubTunnelLabel}" FontFamily="{StaticResource PrimaryFont}" FontSize="14" FontWeight="Bold"
                           Foreground="#FFD400" Margin="4,20,0,6"/>
                <ItemsControl ItemsSource="{Binding HubTunnelBeforeRows}" ItemTemplate="{StaticResource HubRowTemplate}"/>
                <Border Background="#121212" BorderBrush="#33FFD400" BorderThickness="1" CornerRadius="4" Margin="0,4,0,4" Padding="4,2">
                    <StackPanel>
                        <ctrl:SettingsToggleRow Title="{Binding FragmentEnabledLabel}" IsChecked="{Binding FragmentEnabled}"/>
                        <Border Height="1" Background="#22FFFFFF" Margin="8,0"/>
                        <ctrl:SettingsToggleRow Title="{Binding MuxEnabledLabel}" IsChecked="{Binding MuxEnabled}"/>
                        <Border Height="1" Background="#22FFFFFF" Margin="8,0"/>
                        <ctrl:SettingsToggleRow Title="{Binding XrayTunEnabledLabel}" IsChecked="{Binding UseTunMode}"/>
                    </StackPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding HubTunnelAfterRows}" ItemTemplate="{StaticResource HubRowTemplate}"/>

                <TextBlock Text="{Binding HubAdvancedLabel}" FontFamily="{StaticResource PrimaryFont}" FontSize="14" FontWeight="Bold"
                           Foreground="#FFD400" Margin="4,20,0,6"/>
                <ItemsControl ItemsSource="{Binding HubAdvancedBeforeRows}" ItemTemplate="{StaticResource HubRowTemplate}"/>
                <Border Background="#121212" BorderBrush="#33FFD400" BorderThickness="1" CornerRadius="4" Margin="0,4,0,4" Padding="4,2">
                    <StackPanel>
                        <ctrl:SettingsToggleRow Title="{Binding SendHwidHeaderLabel}" IsChecked="{Binding SendHwidHeader}"/>
                        <TextBlock Text="{Binding SendHwidHeaderSummary}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="12,0,12,8"/>
                        <Border Height="1" Background="#22FFFFFF" Margin="8,0"/>
                        <TextBlock Text="{Binding CustomHwidValueLabel}" FontFamily="{StaticResource PrimaryFont}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="12,10,12,4"/>
                        <TextBox Text="{Binding CustomHwidValue}" Style="{StaticResource SearchBox}" Margin="12,0,12,4" Padding="10,6"/>
                        <TextBlock Text="{Binding CustomHwidValueSummary}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="12,0,12,10"/>
                    </StackPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding HubAdvancedAfterRows}" ItemTemplate="{StaticResource HubRowTemplate}"/>

                <TextBlock Text="{Binding HubOtherLabel}" FontFamily="{StaticResource PrimaryFont}" FontSize="14" FontWeight="Bold"
                           Foreground="#FFD400" Margin="4,20,0,6"/>
                <ItemsControl ItemsSource="{Binding HubOtherRows}" ItemTemplate="{StaticResource HubRowTemplate}"/>

                <TextBlock Text="{Binding HubAboutLabel}" FontFamily="{StaticResource PrimaryFont}" FontSize="14" FontWeight="Bold"
                           Foreground="#FFD400" Margin="4,20,0,6"/>
                <ItemsControl ItemsSource="{Binding HubAboutRows}" ItemTemplate="{StaticResource HubRowTemplate}"/>
                <Border Style="{StaticResource GlassCard}" Padding="10,9" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Sumrak VPN" FontFamily="{StaticResource PrimaryFont}" FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding AppVersionLabel}" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="// CODER" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                        <ctrl:CoderCreditBadge HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- GENERAL -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static vm:SettingsSection.General}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{Binding LanguageLabel}" Style="{StaticResource StatLabel}"/>
                        <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" Style="{StaticResource ComboPremium}" Margin="0,8,0,0"
                                  Foreground="{DynamicResource TextPrimaryBrush}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource LanguageDisplay}}"
                                               FontFamily="{StaticResource MonoFont}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontWeight="SemiBold"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{Binding ThemeLabel}" Style="{StaticResource StatLabel}" Margin="0,12,0,0"/>
                        <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}" Style="{StaticResource ComboPremium}" Margin="0,8,0,0"
                                  Foreground="{DynamicResource TextPrimaryBrush}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource ThemeDisplay}}"
                                               FontFamily="{StaticResource MonoFont}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontWeight="SemiBold"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ctrl:SettingsToggleRow Title="{Binding MinimizeToTrayLabel}" IsChecked="{Binding MinimizeToTray}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ADVANCED -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static vm:SettingsSection.Advanced}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{Binding SectionOtherLabel}" FontFamily="{StaticResource PrimaryFont}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                <Border Style="{StaticResource HudCard}" Padding="8">
                    <StackPanel>
                        <ctrl:SettingsToggleRow Title="{Binding UseLocalDnsLabel}" IsChecked="{Binding UseLocalDns}"/>
                        <Border Style="{StaticResource SettingsRowSeparator}"/>
                        <ctrl:SettingsToggleRow Title="{Binding UseDnsFromJsonLabel}" IsChecked="{Binding UseDnsFromJson}"/>
                        <Border Style="{StaticResource SettingsRowSeparator}"/>
                        <ctrl:SettingsToggleRow Title="{Binding EnableServerResolvingLabel}" IsChecked="{Binding EnableServerResolving}"/>
                        <Border Style="{StaticResource SettingsRowSeparator}"/>
                        <ctrl:SettingsToggleRow Title="{Binding SniffTrafficLabel}" IsChecked="{Binding SniffTraffic}"/>
                        <Border Style="{StaticResource SettingsRowSeparator}"/>
                        <ctrl:SettingsToggleRow Title="{Binding AutoStartLabel}" IsChecked="{Binding AutoStartEnabled}"/>
                        <Border Style="{StaticResource SettingsRowSeparator}"/>
                        <ctrl:SettingsToggleRow Title="{Binding UseSystemProxyLabel}" IsChecked="{Binding UseSystemProxy}"/>
                        <Border Style="{StaticResource SettingsRowSeparator}"/>
                        <ctrl:SettingsToggleRow Title="{Binding BypassLocalLabel}" IsChecked="{Binding BypassLocalForSystemProxy}"/>
                        <Border Style="{StaticResource SettingsRowSeparator}"/>
                        <ctrl:SettingsToggleRow Title="{Binding UseTunModeLabel}" IsChecked="{Binding UseTunMode}"/>
                        <Border Style="{StaticResource SettingsRowSeparator}"/>
                        <Grid Margin="12,10" MinHeight="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding TunProviderLabel}" FontFamily="{StaticResource PrimaryFont}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" MinWidth="140" ItemsSource="{Binding TunProviders}" SelectedItem="{Binding SelectedTunProvider}" Style="{StaticResource ComboPremium}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource TunProviderDisplay}}" FontFamily="{StaticResource PrimaryFont}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <Border Style="{StaticResource SettingsRowSeparator}"/>
                        <Button Style="{StaticResource SecondaryButton}" Margin="12,8" Padding="16,12" HorizontalContentAlignment="Stretch"
                                Command="{Binding OpenExcludedRoutesCommand}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ExcludedRoutesLabel}" FontFamily="{StaticResource PrimaryFont}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="›" Foreground="{DynamicResource NeonBlueBrush}" FontSize="18"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- CORE (v2rayNG parity: Mux / Fragment / DNS / IPv6) -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static vm:SettingsSection.Core}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Style="{StaticResource HudCard}" Padding="8" Margin="0,0,0,12">
                    <StackPanel>
                        <Button Style="{StaticResource SecondaryButton}" Margin="4,4,4,8" Padding="10,10" HorizontalContentAlignment="Stretch"
                                Command="{Binding OpenAppProxySettingsCommand}"
                                ToolTip="{Binding AppProxySettingsHint}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding AppProxySettingsLabel}" FontFamily="{StaticResource PrimaryFont}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="ℹ" FontSize="12" Foreground="{DynamicResource NeonBlueBrush}"
                                           VerticalAlignment="Center" Margin="8,0,8,0"
                                           ToolTip="{Binding AppProxySettingsHint}"/>
                                <TextBlock Grid.Column="2" Text="›" Foreground="{DynamicResource NeonBlueBrush}" FontSize="14" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <Border Style="{StaticResource SettingsRowSeparator}"/>
                        <ctrl:SettingsToggleRow Title="{Binding FragmentEnabledLabel}" IsChecked="{Binding FragmentEnabled}"/>
                        <TextBlock Text="{Binding FragmentCoreTypeLabel}" Style="{StaticResource StatLabel}" Margin="12,8,12,0"/>
                        <ComboBox ItemsSource="{Binding FragmentEngineOptions}" SelectedItem="{Binding FragmentEngine}" Style="{StaticResource ComboPremium}" Margin="12,8,12,0" IsEnabled="{Binding FragmentEnabled}"/>
                        <TextBlock Text="{Binding FragmentPacketsLabel}" Style="{StaticResource StatLabel}" Margin="12,8,12,0"/>
                        <ComboBox ItemsSource="{Binding FragmentPacketOptions}" SelectedItem="{Binding FragmentPackets}"
                                  IsEditable="True" StaysOpenOnEdit="True"
                                  Style="{StaticResource ComboPremium}" Margin="12,8,12,0" IsEnabled="{Binding FragmentEnabled}"/>
                        <TextBlock Text="{Binding FragmentLengthLabel}" Style="{StaticResource StatLabel}" Margin="12,8,12,0"/>
                        <TextBox Text="{Binding FragmentLength}" Style="{StaticResource SearchBox}" Margin="12,8,12,0" IsEnabled="{Binding FragmentEnabled}"/>
                        <TextBlock Text="{Binding FragmentIntervalLabel}" Style="{StaticResource StatLabel}" Margin="12,8,12,0"/>
                        <TextBox Text="{Binding FragmentInterval}" Style="{StaticResource SearchBox}" Margin="12,8,12,0" IsEnabled="{Binding FragmentEnabled}"/>
                        <TextBlock Text="{Binding FragmentMaxSplitLabel}" Style="{StaticResource StatLabel}" Margin="12,8,12,0"/>
                        <TextBox Text="{Binding FragmentMaxSplit}" Style="{StaticResource SearchBox}" Margin="12,8,12,0" IsEnabled="{Binding FragmentEnabled}"/>
                        <Border Style="{StaticResource SettingsRowSeparator}"/>
                        <ctrl:SettingsToggleRow Title="{Binding NoiseEnabledLabel}" IsChecked="{Binding NoiseEnabled}"/>
                        <TextBlock Text="{Binding NoiseRandLabel}" Style="{StaticResource StatLabel}" Margin="12,8,12,0"/>
                        <TextBox Text="{Binding NoiseRand}" Style="{StaticResource SearchBox}" Margin="12,8,12,0" IsEnabled="{Binding NoiseEnabled}"/>
                        <TextBlock Text="{Binding NoiseDelayLabel}" Style="{StaticResource StatLabel}" Margin="12,8,12,0"/>
                        <TextBox Text="{Binding NoiseDelay}" Style="{StaticResource SearchBox}" Margin="12,8,12,0" IsEnabled="{Binding NoiseEnabled}"/>
                        <Border Style="{StaticResource SettingsRowSeparator}"/>
                        <ctrl:SettingsToggleRow Title="{Binding MuxEnabledLabel}" IsChecked="{Binding MuxEnabled}"/>
                        <TextBlock Text="{Binding MuxConcurrencyLabel}" Style="{StaticResource StatLabel}" Margin="12,8,12,0"/>
                        <TextBox Text="{Binding MuxConcurrency}" Style="{StaticResource SearchBox}" Margin="12,8,12,0" IsEnabled="{Binding MuxEnabled}"/>
                        <TextBlock Text="{Binding MuxXudpConcurrencyLabel}" Style="{StaticResource StatLabel}" Margin="12,8,12,0"/>
                        <TextBox Text="{Binding MuxXudpConcurrency}" Style="{StaticResource SearchBox}" Margin="12,8,12,0" IsEnabled="{Binding MuxEnabled}"/>
                        <TextBlock Text="{Binding MuxXudpQuicLabel}" Style="{StaticResource StatLabel}" Margin="12,8,12,0"/>
                        <ComboBox ItemsSource="{Binding MuxXudpQuicChoices}" SelectedItem="{Binding SelectedMuxXudpQuic}"
                                  DisplayMemberPath="Display" Style="{StaticResource ComboPremium}" Margin="12,8,12,0" IsEnabled="{Binding MuxEnabled}"/>
                        <Border Style="{StaticResource SettingsRowSeparator}"/>
                        <TextBlock Text="{Binding PreferredIpTypeLabel}" Style="{StaticResource StatLabel}" Margin="12,8,12,0"/>
                        <ComboBox ItemsSource="{Binding PreferredIpTypeOptions}" SelectedItem="{Binding SelectedPreferredIpType}" Style="{StaticResource ComboPremium}" Margin="12,8,12,0"/>
                        <Border Style="{StaticResource SettingsRowSeparator}"/>
                        <Button Style="{StaticResource SecondaryButton}" Margin="4,8,4,4" Padding="10,10" HorizontalContentAlignment="Stretch"
                                Command="{Binding OpenInboundsCommand}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding InboundsLabel}" FontFamily="{StaticResource PrimaryFont}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding InboundsStatusLabel}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="2" Text="›" Foreground="{DynamicResource NeonBlueBrush}" FontSize="14" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource HudCard}" Padding="8" Margin="0,0,0,12">
                    <StackPanel>
                        <ctrl:SettingsToggleRow Title="{Binding Ipv6EnabledLabel}" IsChecked="{Binding Ipv6Enabled}"/>
                        <ctrl:SettingsToggleRow Title="{Binding PreferIpv6Label}" IsChecked="{Binding PreferIpv6}"/>
                        <ctrl:SettingsToggleRow Title="{Binding FakeDnsEnabledLabel}" IsChecked="{Binding FakeDnsEnabled}"/>
                        <ctrl:SettingsToggleRow Title="{Binding RouteOnlyLabel}" IsChecked="{Binding RouteOnly}"/>
                        <ctrl:SettingsToggleRow Title="{Binding SocksEnableUdpLabel}" IsChecked="{Binding SocksEnableUdp}"/>
                        <Border Style="{StaticResource SettingsRowSeparator}"/>
                        <TextBlock Text="{Binding DomesticDnsLabel}" Style="{StaticResource StatLabel}" Margin="12,8,12,0"/>
                        <TextBox Text="{Binding DomesticDns}" Style="{StaticResource SearchBox}" Margin="12,8,12,0"/>
                        <TextBlock Text="{Binding DnsHostsLabel}" Style="{StaticResource StatLabel}" Margin="12,8,12,0"/>
                        <TextBox Text="{Binding DnsHosts}" Style="{StaticResource SearchBox}" AcceptsReturn="True" MinHeight="64" TextWrapping="Wrap" Margin="12,8,12,0"/>
                        <TextBlock Text="{Binding CoreLogLevelLabel}" Style="{StaticResource StatLabel}" Margin="12,8,12,0"/>
                        <ComboBox ItemsSource="{Binding CoreLogLevels}" SelectedItem="{Binding CoreLogLevel}" Style="{StaticResource ComboPremium}" Margin="12,8,12,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- PING (v2rayNG Advanced в†’ Ping) -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static vm:SettingsSection.Ping}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Style="{StaticResource HudCard}" Padding="8">
                    <StackPanel>
                        <TextBlock Text="{Binding PingTypeLabel}" Style="{StaticResource StatLabel}" Margin="12,8,12,0"/>
                        <ComboBox ItemsSource="{Binding PingTypes}" SelectedItem="{Binding SelectedPingType}" Style="{StaticResource ComboPremium}" Margin="12,8,12,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource PingTypeDisplay}}" FontFamily="{StaticResource PrimaryFont}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Border Style="{StaticResource SettingsRowSeparator}"/>
                        <ctrl:SettingsToggleRow Title="{Binding PingOnStartLabel}" IsChecked="{Binding PingOnStart}"/>
                        <ctrl:SettingsToggleRow Title="{Binding AutoSelectFastestLabel}" IsChecked="{Binding AutoSelectFastest}"/>
                        <ctrl:SettingsToggleRow Title="{Binding AutoSortAfterTestLabel}" IsChecked="{Binding AutoSortAfterTest}"/>
                        <ctrl:SettingsToggleRow Title="{Binding AutoRemoveInvalidAfterTestLabel}" IsChecked="{Binding AutoRemoveInvalidAfterTest}"/>
                        <Border Style="{StaticResource SettingsRowSeparator}"/>
                        <TextBlock Text="{Binding DelayTestUrlLabel}" Style="{StaticResource StatLabel}" Margin="12,8,12,0"/>
                        <TextBox Text="{Binding DelayTestUrl}" Style="{StaticResource SearchBox}" Margin="12,8,12,0"/>
                        <TextBlock Text="{Binding IpApiUrlLabel}" Style="{StaticResource StatLabel}" Margin="12,8,12,0"/>
                        <TextBox Text="{Binding IpApiUrl}" Style="{StaticResource SearchBox}" Margin="12,8,12,0"/>
                        <TextBlock Text="{Binding RealPingConcurrencyLabel}" Style="{StaticResource StatLabel}" Margin="12,8,12,0"/>
                        <TextBox Text="{Binding RealPingConcurrency}" Style="{StaticResource SearchBox}" Margin="12,8,12,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- SUBSCRIPTIONS -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static vm:SettingsSection.Subscriptions}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,12" Padding="8">
                    <StackPanel>
                        <TextBlock Text="{Binding SubscriptionUrlsLabel}" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="12,8,12,8"/>
                        <ListBox ItemsSource="{Binding SubscriptionUrls}" SelectedItem="{Binding SelectedSubscriptionUrl}"
                                 MaxHeight="120" Margin="12,0" Background="Transparent" BorderThickness="0"/>
                        <Grid Margin="12,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding NewSubscriptionUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="{Binding AddSubscriptionLabel}" Style="{StaticResource SecondaryButton}" Command="{Binding AddSubscriptionUrlCommand}" Margin="0,0,8,0"/>
                            <Button Grid.Column="2" Content="{Binding RemoveSubscriptionLabel}" Style="{StaticResource SecondaryButton}" Command="{Binding RemoveSubscriptionUrlCommand}"/>
                        </Grid>
                        <ctrl:SettingsToggleRow Title="{Binding AutoRefreshSubscriptionsLabel}" IsChecked="{Binding AutoRefreshSubscriptions}"/>
                        <ctrl:SettingsToggleRow Title="{Binding UpdateSubscriptionsOnStartLabel}" IsChecked="{Binding UpdateSubscriptionsOnStart}"/>
                        <ctrl:SettingsToggleRow Title="{Binding ConnectOnStartLabel}" IsChecked="{Binding ConnectOnStart}"/>
                        <ctrl:SettingsToggleRow Title="{Binding IgnoreDuplicatesLabel}" IsChecked="{Binding IgnoreDuplicateServers}"/>
                        <ctrl:SettingsToggleRow Title="{Binding PurgeOldProfilesLabel}" IsChecked="{Binding PurgeOldProfilesOnSubscriptionUpdate}"/>
                        <StackPanel Margin="12,8">
                            <TextBlock Text="{Binding SubscriptionRefreshIntervalLabel}" Style="{StaticResource StatLabel}"/>
                            <ComboBox ItemsSource="{Binding RefreshIntervalOptions}" SelectedItem="{Binding SubscriptionRefreshIntervalMinutes}"
                                      Style="{StaticResource ComboPremium}" Margin="0,8,0,0"/>
                        </StackPanel>
                        <Button Content="{Binding RefreshSubscriptionsLabel}" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshSubscriptionsCommand}" Margin="12,8"/>
                        <TextBlock Text="{Binding SubscriptionTrafficLabel}" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="12,12,12,4"/>
                        <ItemsControl ItemsSource="{Binding SubscriptionTrafficRows}" Margin="12,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="10" Background="#FFD400FF" CornerRadius="6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Url}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{DynamicResource NeonGreenBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding TrafficText}" FontFamily="{StaticResource PrimaryFont}" FontSize="12" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding ExpireText}" FontFamily="{StaticResource PrimaryFont}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- TUNNEL -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static vm:SettingsSection.Tunnel}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Style="{StaticResource HudCard}" Padding="8">
                    <StackPanel>
                        <StackPanel Visibility="{Binding IsSingBoxTunProvider, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="{Binding TunStackModeLabel}" Style="{StaticResource StatLabel}" Margin="12,8,12,0"/>
                        <ComboBox ItemsSource="{Binding TunStackModes}" SelectedItem="{Binding SelectedTunStackMode}" Style="{StaticResource ComboPremium}" Margin="12,8,12,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource TunStackDisplay}}" FontFamily="{StaticResource PrimaryFont}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="{Binding TunMtuLabel}" Style="{StaticResource StatLabel}" Margin="12,12,12,0"/>
                        <TextBox Text="{Binding TunMtu}" Style="{StaticResource SearchBox}" Margin="12,8,12,0"/>

                        <Border Style="{StaticResource SettingsRowSeparator}"/>

                        <ctrl:SettingsToggleRow Title="{Binding TunDnsEnableLabel}" IsChecked="{Binding TunDnsEnable}"/>
                        <TextBlock Text="{Binding TunDnsAddressLabel}" Style="{StaticResource StatLabel}" Margin="12,8,12,0"/>
                        <TextBox Text="{Binding DnsServer}" Style="{StaticResource SearchBox}" Margin="12,8,12,0"
                                 IsEnabled="{Binding TunDnsEnable}"/>
                        </StackPanel>

                        <Border Style="{StaticResource SettingsRowSeparator}"/>

                        <ctrl:SettingsToggleRow Title="{Binding CheckConflictsLabel}" IsChecked="{Binding CheckConflictsOnStart}"/>

                        <Button Content="{Binding RunConflictCheckLabel}" Style="{StaticResource SecondaryButton}" Command="{Binding RunConflictCheckCommand}" Margin="12,8"/>
                        <ItemsControl ItemsSource="{Binding ConflictRows}" Margin="12,0,12,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12"/>
                                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ROUTING -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static vm:SettingsSection.Routing}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Style="{StaticResource HudCard}" Padding="8">
                    <StackPanel>
                        <ctrl:SettingsToggleRow Title="{Binding RoutingEnabledLabel}" IsChecked="{Binding RoutingEnabled}"/>
                        <Border Style="{StaticResource SettingsRowSeparator}"/>
                        <Grid Margin="12,10" MinHeight="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding SubscriptionUserAgentLabel}" FontFamily="{StaticResource PrimaryFont}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" MinWidth="180" ItemsSource="{Binding UserAgentPresets}" SelectedItem="{Binding SelectedUserAgent}" Style="{StaticResource ComboPremium}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource UserAgentDisplay}}" FontFamily="{StaticResource PrimaryFont}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding RoutingRulesDesc}" FontFamily="{StaticResource PrimaryFont}" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="4,12,4,16"/>
                <Border Style="{StaticResource GlassCard}" Padding="16" Visibility="{Binding RoutingEnabled, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding RoutingModeLabel}" Style="{StaticResource StatLabel}"/>
                        <ComboBox ItemsSource="{Binding RoutingModes}" SelectedItem="{Binding SelectedRoutingMode}" Style="{StaticResource ComboPremium}" Margin="0,8,0,12"/>
                        <TextBlock Text="{Binding SplitTunnelLabel}" Style="{StaticResource StatLabel}"/>
                        <TextBox Text="{Binding SplitTunnelProcesses}" Style="{StaticResource SearchBox}" AcceptsReturn="True" MinHeight="64" TextWrapping="Wrap" Margin="0,8,0,12"/>
                        <TextBlock Text="{Binding DomainDirectRulesLabel}" Style="{StaticResource StatLabel}"/>
                        <TextBox Text="{Binding DomainDirectRules}" Style="{StaticResource SearchBox}" AcceptsReturn="True" MinHeight="96" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- CONNECTION -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static vm:SettingsSection.Connection}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Style="{StaticResource HudCard}" Padding="8">
                    <StackPanel>
                        <ctrl:SettingsToggleRow Title="{Binding KillSwitchLabel}" IsChecked="{Binding KillSwitchEnabled}"/>
                        <Border Style="{StaticResource SettingsRowSeparator}"/>
                        <ctrl:SettingsToggleRow Title="{Binding SendHwidHeaderLabel}" IsChecked="{Binding SendHwidHeader}"/>
                        <TextBlock Text="{Binding SendHwidHeaderSummary}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="12,0,12,8"/>
                        <TextBlock Text="{Binding CustomHwidValueLabel}" Style="{StaticResource StatLabel}" Margin="12,4,12,0"/>
                        <TextBox Text="{Binding CustomHwidValue}" Style="{StaticResource SearchBox}" Margin="12,8,12,4"/>
                        <TextBlock Text="{Binding CustomHwidValueSummary}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="12,0,12,8"/>
                        <Border Style="{StaticResource SettingsRowSeparator}"/>
                        <ctrl:SettingsToggleRow Title="{Binding DnsLeakLabel}" IsChecked="{Binding DnsLeakProtection}"/>
                        <ctrl:SettingsToggleRow Title="{Binding AutoReconnectLabel}" IsChecked="{Binding AutoReconnect}"/>
                        <ctrl:SettingsToggleRow Title="{Binding AutoSelectFastestLabel}" IsChecked="{Binding AutoSelectFastest}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- VPN HOTSPOT -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static vm:SettingsSection.VpnHotspot}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{Binding VpnHotspotIntro}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="4,0,4,12"/>
                <Border Style="{StaticResource HudCard}" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding VpnHotspotStatusVpnLabel}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding VpnHotspotVpnStatus}" Foreground="#FFD400"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding VpnHotspotStatusProxyLabel}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding VpnHotspotProxyStatus}" Foreground="#FFD400"/>
                        </Grid>
                        <Border Style="{StaticResource SettingsRowSeparator}"/>
                        <ctrl:SettingsToggleRow Title="{Binding AllowLanLabel}" IsChecked="{Binding AllowLanConnections}"/>
                        <TextBlock Text="{Binding AllowLanDesc}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="12,0,12,8"/>
                        <TextBlock Text="{Binding VpnHotspotReconnectHint}" FontSize="11" Foreground="#FFD400"
                                   TextWrapping="Wrap" Margin="12,0,12,10"/>
                        <TextBlock Text="{Binding VpnHotspotProxyLinesLabel}" FontWeight="SemiBold" Margin="12,0,0,4"/>
                        <TextBlock Text="{Binding VpnHotspotHostIp}" FontFamily="{StaticResource MonoFont}" FontSize="13"
                                   Foreground="{DynamicResource NeonGreenBrush}" Margin="12,0,0,4"/>
                        <TextBlock Text="{Binding VpnHotspotProxyLines}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="12,0,12,10"/>
                        <WrapPanel Margin="8,0,0,4">
                            <Button Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Padding="12,8"
                                    Command="{Binding CopyVpnHotspotProxyCommand}" Content="{Binding CopyHotspotProxyLabel}"/>
                            <Button Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Padding="12,8"
                                    Command="{Binding OpenWindowsHotspotSettingsCommand}" Content="{Binding OpenWindowsHotspotLabel}"/>
                            <Button Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Padding="12,8"
                                    Command="{Binding OpenNetworkAdaptersCommand}" Content="{Binding OpenNetworkAdaptersLabel}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding VpnHotspotSteps}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="4,0,4,8"/>
                <TextBlock Text="{Binding VpnHotspotIcsNote}" FontSize="10" Opacity="0.85"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="4,0,4,12"/>
            </StackPanel>

            <!-- NETWORK -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static vm:SettingsSection.Network}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Style="{StaticResource GlassCard}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{Binding DnsServerLabel}" Style="{StaticResource StatLabel}"/>
                        <TextBox Text="{Binding DnsServer}" Style="{StaticResource SearchBox}" Margin="0,8,0,12"/>
                        <TextBlock Text="{Binding RemoteDnsLabel}" Style="{StaticResource StatLabel}"/>
                        <TextBox Text="{Binding RemoteDns}" Style="{StaticResource SearchBox}" Margin="0,8,0,12"/>
                        <TextBlock Text="{Binding LocalSocksPortLabel}" Style="{StaticResource StatLabel}"/>
                        <TextBox Text="{Binding LocalSocksPort}" Style="{StaticResource SearchBox}" Margin="0,8,0,12"/>
                        <TextBlock Text="{Binding LocalHttpPortLabel}" Style="{StaticResource StatLabel}"/>
                        <TextBox Text="{Binding LocalHttpPort}" Style="{StaticResource SearchBox}" Margin="0,8,0,12"/>
                        <ctrl:SettingsToggleRow Title="{Binding AllowLanLabel}" IsChecked="{Binding AllowLanConnections}"/>
                        <TextBlock Text="{Binding LanInfoLabel}" Foreground="{DynamicResource NeonGreenBrush}" FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="0,12,0,0"/>
                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="0,4,0,0">
                            <Run Text="IP: "/><Run Text="{Binding LocalLanIp}"/>
                            <Run Text="  SOCKS: "/><Run Text="{Binding LocalSocksPort}"/>
                            <Run Text="  HTTP: "/><Run Text="{Binding LocalHttpPort}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- LOGS -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static vm:SettingsSection.Logs}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Style="{StaticResource GlassCard}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <Button Content="{Binding RefreshLogsLabel}" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshLogsCommand}" Margin="0,0,0,12"/>
                        <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding LogText}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- DATA -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static vm:SettingsSection.Data}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <WrapPanel Margin="0,0,0,12">
                    <Button Content="{Binding BackupLabel}" Style="{StaticResource SecondaryButton}" Command="{Binding BackupCommand}" Margin="0,0,8,8"/>
                    <Button Content="{Binding RestoreLabel}" Style="{StaticResource SecondaryButton}" Command="{Binding RestoreCommand}" Margin="0,0,8,8"/>
                </WrapPanel>
            </StackPanel>

            <!-- DIAGNOSTICS -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static vm:SettingsSection.Diagnostics}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Style="{StaticResource GlassCard}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <WrapPanel Margin="0,0,0,12">
                            <Button Content="{Binding RunDiagnosticsLabel}" Style="{StaticResource SecondaryButton}" Command="{Binding RunDiagnosticsCommand}" Margin="0,0,8,8"/>
                            <Button Content="{Binding ExportDebugLabel}" Style="{StaticResource SecondaryButton}" Command="{Binding ExportDebugBundleCommand}" Margin="0,0,8,8"/>
                        </WrapPanel>
                        <ItemsControl ItemsSource="{Binding DiagnosticRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding StatusGlyph}" FontFamily="{StaticResource MonoFont}" FontSize="14" Foreground="{DynamicResource NeonGreenBrush}"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource PrimaryFont}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Detail}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Every setting is persisted automatically (debounced), so no Save button. -->
        </StackPanel>
    </ScrollViewer>
</UserControl>
