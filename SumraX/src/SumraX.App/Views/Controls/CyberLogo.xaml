<UserControl x:Class="SumraX.App.Views.Controls.CyberLogo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Width="32" Height="32">
    <Border CornerRadius="6" BorderBrush="#FFD400" BorderThickness="1" Background="#0A0A0B" Padding="1"
            ClipToBounds="True" SnapsToDevicePixels="True">
        <Image Source="/Assets/sumrax-icon-32.png"
               Width="28" Height="28"
               Stretch="None"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality"/>
    </Border>
</UserControl>