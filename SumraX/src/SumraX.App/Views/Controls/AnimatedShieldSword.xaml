<UserControl x:Class="SumraX.App.Views.Controls.AnimatedShieldSword"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Width="220" Height="220"
             ClipToBounds="True">
    <UserControl.Resources>
        <SolidColorBrush x:Key="BackPanelFill" Color="#111112"/>
        <SolidColorBrush x:Key="BackPanelActive" Color="#0A0A0B"/>
        <LinearGradientBrush x:Key="BackGradient" StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="#1C1C1E" Offset="0"/>
            <GradientStop Color="#111112" Offset="0.5"/>
            <GradientStop Color="#0A0A0B" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="IceScreenGradient" StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="#0F0F10" Offset="0"/>
            <GradientStop Color="#0A0A0B" Offset="0.55"/>
            <GradientStop Color="#080809" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="IceTextBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#FFF3B0" Offset="0.38"/>
            <GradientStop Color="#FFFFFF" Offset="0.52"/>
            <GradientStop Color="#FFD400" Offset="1"/>
        </LinearGradientBrush>

        <Storyboard x:Key="IdleStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="RingOuter" Storyboard.TargetProperty="Opacity"
                             From="0.22" To="0.42" Duration="0:0:2.8" AutoReverse="True"/>
        </Storyboard>

        <Storyboard x:Key="ConnectingStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="RingOuterRotate" Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:2.2"/>
            <DoubleAnimation Storyboard.TargetName="RingInnerRotate" Storyboard.TargetProperty="Angle"
                             From="360" To="0" Duration="0:0:3.4"/>
            <DoubleAnimation Storyboard.TargetName="RingOuter" Storyboard.TargetProperty="Opacity"
                             From="0.35" To="0.75" Duration="0:0:1.1" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="RingInner" Storyboard.TargetProperty="Opacity"
                             From="0.18" To="0.5" Duration="0:0:0.9" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="PulseRing1Scale" Storyboard.TargetProperty="ScaleX"
                             From="0.88" To="1.12" Duration="0:0:1.5" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="PulseRing1Scale" Storyboard.TargetProperty="ScaleY"
                             From="0.88" To="1.12" Duration="0:0:1.5" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="PulseRing1" Storyboard.TargetProperty="Opacity"
                             From="0.08" To="0.28" Duration="0:0:1.5" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="ScanLineMove" Storyboard.TargetProperty="Y"
                             From="0" To="44" Duration="0:0:1.4" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="ConnectLabel" Storyboard.TargetProperty="Opacity"
                             From="0.45" To="1" Duration="0:0:0.85" AutoReverse="True"/>
        </Storyboard>

        <Storyboard x:Key="TunConnectingStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="RingOuterRotate" Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:1.35"/>
            <DoubleAnimation Storyboard.TargetName="RingInnerRotate" Storyboard.TargetProperty="Angle"
                             From="360" To="0" Duration="0:0:1.9"/>
            <DoubleAnimation Storyboard.TargetName="TunArcRotate" Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:1.1"/>
            <DoubleAnimation Storyboard.TargetName="RingOuter" Storyboard.TargetProperty="Opacity"
                             From="0.45" To="0.95" Duration="0:0:0.75" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="RingInner" Storyboard.TargetProperty="Opacity"
                             From="0.25" To="0.65" Duration="0:0:0.65" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="PulseRing1Scale" Storyboard.TargetProperty="ScaleX"
                             From="0.9" To="1.18" Duration="0:0:1.1" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="PulseRing1Scale" Storyboard.TargetProperty="ScaleY"
                             From="0.9" To="1.18" Duration="0:0:1.1" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="PulseRing1" Storyboard.TargetProperty="Opacity"
                             From="0.12" To="0.38" Duration="0:0:1.1" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="PulseRing2Scale" Storyboard.TargetProperty="ScaleX"
                             From="0.82" To="1.28" Duration="0:0:1.6" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="PulseRing2Scale" Storyboard.TargetProperty="ScaleY"
                             From="0.82" To="1.28" Duration="0:0:1.6" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="PulseRing2" Storyboard.TargetProperty="Opacity"
                             From="0" To="0.22" Duration="0:0:1.6" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="ScanLineMove" Storyboard.TargetProperty="Y"
                             From="0" To="46" Duration="0:0:0.95" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="ConnectLabel" Storyboard.TargetProperty="Opacity"
                             From="0.55" To="1" Duration="0:0:0.55" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="ScreenGlow" Storyboard.TargetProperty="Opacity"
                             From="0.35" To="0.85" Duration="0:0:0.8" AutoReverse="True"/>
        </Storyboard>

        <Storyboard x:Key="IceRevealStoryboard">
            <DoubleAnimation Storyboard.TargetName="IceFlash" Storyboard.TargetProperty="Opacity"
                             From="0" To="0.85" Duration="0:0:0.12" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="IceScreenGlow" Storyboard.TargetProperty="Opacity"
                             From="0" To="0.55" BeginTime="0:0:0.08" Duration="0:0:0.45">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="BlockServiceBloom" Storyboard.TargetProperty="Opacity"
                             From="0" To="0.95" BeginTime="0:0:0.1" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="BlockServiceLabel" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" BeginTime="0:0:0.12" Duration="0:0:0.55">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="BlockServiceScale" Storyboard.TargetProperty="ScaleX"
                             From="0.72" To="1" BeginTime="0:0:0.12" Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.42"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="BlockServiceScale" Storyboard.TargetProperty="ScaleY"
                             From="0.72" To="1" BeginTime="0:0:0.12" Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.42"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="IceRing" Storyboard.TargetProperty="Opacity"
                             From="0" To="0.75" BeginTime="0:0:0.2" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="IceShimmerStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="BlockServiceGlow" Storyboard.TargetProperty="Opacity"
                             From="0.65" To="1" Duration="0:0:1.5" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="BlockServiceBloom" Storyboard.TargetProperty="Opacity"
                             From="0.75" To="1" Duration="0:0:1.8" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="IceRing" Storyboard.TargetProperty="Opacity"
                             From="0.45" To="0.95" Duration="0:0:2" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="IceScreenGlow" Storyboard.TargetProperty="Opacity"
                             From="0.35" To="0.65" Duration="0:0:2.2" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="ScreenGlow" Storyboard.TargetProperty="Opacity"
                             From="0.45" To="0.85" Duration="0:0:1.9" AutoReverse="True"/>
        </Storyboard>
    </UserControl.Resources>

    <Grid ClipToBounds="True">
        <Ellipse x:Name="PulseRing2" Width="210" Height="210" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Stroke="#FFD400" StrokeThickness="1" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="PulseRing2Scale" ScaleX="1" ScaleY="1"/>
            </Ellipse.RenderTransform>
        </Ellipse>

        <Ellipse x:Name="PulseRing1" Width="188" Height="188" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Stroke="#FFC400" StrokeThickness="1.2" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="PulseRing1Scale" ScaleX="1" ScaleY="1"/>
            </Ellipse.RenderTransform>
        </Ellipse>

        <Ellipse x:Name="RingOuter" Width="200" Height="200" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Stroke="#FFC400" StrokeThickness="1" Opacity="0.32" StrokeDashArray="4 6" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <RotateTransform x:Name="RingOuterRotate" Angle="0"/>
            </Ellipse.RenderTransform>
        </Ellipse>

        <Ellipse x:Name="RingInner" Width="168" Height="168" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Stroke="#FFD400" StrokeThickness="0.8" Opacity="0.22" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <RotateTransform x:Name="RingInnerRotate" Angle="0"/>
            </Ellipse.RenderTransform>
        </Ellipse>

        <Ellipse x:Name="TunArc" Width="178" Height="178" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Opacity="0" StrokeThickness="2.5" StrokeDashArray="18 120" RenderTransformOrigin="0.5,0.5">
            <Ellipse.Stroke>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FFB800" Offset="0"/>
                    <GradientStop Color="#FFC400" Offset="1"/>
                </LinearGradientBrush>
            </Ellipse.Stroke>
            <Ellipse.RenderTransform>
                <RotateTransform x:Name="TunArcRotate" Angle="0"/>
            </Ellipse.RenderTransform>
            <Ellipse.Effect>
                <DropShadowEffect Color="#FFB800" BlurRadius="14" ShadowDepth="0" Opacity="0.65"/>
            </Ellipse.Effect>
        </Ellipse>

        <Ellipse x:Name="IceRing" Width="192" Height="192" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Opacity="0" StrokeThickness="2">
            <Ellipse.Stroke>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FFF9D6FF" Offset="0"/>
                    <GradientStop Color="#FFE680" Offset="0.45"/>
                    <GradientStop Color="#FFC400FF" Offset="1"/>
                </LinearGradientBrush>
            </Ellipse.Stroke>
            <Ellipse.Effect>
                <DropShadowEffect Color="#FFD400" BlurRadius="18" ShadowDepth="0" Opacity="0.75"/>
            </Ellipse.Effect>
        </Ellipse>

        <Viewbox x:Name="MonoblockViewbox" Width="168" Height="120" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
            <Canvas Width="168" Height="120" ClipToBounds="True">
                <!-- Laptop base -->
                <Path Fill="#232325" Stroke="#2A2A2C" StrokeThickness="1"
                      Data="M 14,78 C 14,76 16,74 20,74 L 148,74 C 152,74 154,76 154,78 L 158,108 C 158,110 156,112 152,112 L 16,112 C 12,112 10,110 10,108 Z"/>
                <!-- Keyboard -->
                <Rectangle Canvas.Left="24" Canvas.Top="82" Width="120" Height="22" RadiusX="2" RadiusY="2"
                           Fill="#161617" Stroke="#2A2A2C" StrokeThickness="0.6"/>
                <!-- Trackpad -->
                <Rectangle Canvas.Left="58" Canvas.Top="106" Width="52" Height="4" RadiusX="2" RadiusY="2" Fill="#131314"/>

                <!-- Lid / screen bezel -->
                <Border Canvas.Left="18" Canvas.Top="6" Width="132" Height="72" CornerRadius="6"
                        Background="#2A2A2C" BorderBrush="#7A7A72" BorderThickness="1.2">
                    <Border x:Name="ScreenBezel" Margin="4" CornerRadius="4" Background="#0A0A0B" BorderBrush="#1E1E20" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect x:Name="ScreenGlow" Color="#FFC400" BlurRadius="10" ShadowDepth="0" Opacity="0.18"/>
                        </Border.Effect>
                        <Grid x:Name="ScreenBg" ClipToBounds="True">
                            <Rectangle x:Name="IceScreenGlow" Fill="#FFB800FF" Opacity="0" IsHitTestVisible="False"/>
                            <Rectangle x:Name="IceFlash" Fill="#FFF3B0FF" Opacity="0" IsHitTestVisible="False"/>

                            <Rectangle x:Name="ScanLine" Height="2" Margin="6,6,6,0" VerticalAlignment="Top"
                                       Fill="#FF8A00FF" Opacity="0" RenderTransformOrigin="0.5,0">
                                <Rectangle.RenderTransform>
                                    <TranslateTransform x:Name="ScanLineMove" Y="0"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>

                            <!-- Idle desktop wallpaper -->
                            <Canvas x:Name="IdleScreenDecor" ClipToBounds="True">
                                <Rectangle Width="124" Height="60" Fill="#111112"/>
                                <Rectangle Canvas.Left="8" Canvas.Top="8" Width="44" Height="32" RadiusX="2" RadiusY="2"
                                           Fill="#161617" Stroke="#2A2A2C" StrokeThickness="0.6" Opacity="0.9"/>
                                <Rectangle Canvas.Left="56" Canvas.Top="8" Width="60" Height="20" RadiusX="2" RadiusY="2"
                                           Fill="#111112" Stroke="#232320" StrokeThickness="0.6" Opacity="0.85"/>
                                <Rectangle Canvas.Left="56" Canvas.Top="32" Width="60" Height="16" RadiusX="2" RadiusY="2"
                                           Fill="#111112" Stroke="#232320" StrokeThickness="0.6" Opacity="0.75"/>
                                <Rectangle Canvas.Left="0" Canvas.Top="48" Width="124" Height="12" Fill="#0C0C0D" Opacity="0.95"/>
                                <Rectangle Canvas.Left="48" Canvas.Top="50" Width="28" Height="8" RadiusX="2" RadiusY="2" Fill="#1E1E20"/>
                            </Canvas>

                            <TextBlock x:Name="ConnectLabel" Text="TUN" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="{StaticResource PrimaryFont}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#FFD400" Opacity="0" IsHitTestVisible="False"/>

                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="BlockServiceScale" ScaleX="1" ScaleY="1"/>
                                </Grid.RenderTransform>
                                <TextBlock x:Name="BlockServiceBloom" Text="BLOCK&#x0a;SERVICE"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontFamily="{StaticResource PrimaryFont}" FontSize="11" FontWeight="Bold"
                                           TextAlignment="Center" LineHeight="13"
                                           Foreground="#FFE066" Opacity="0" IsHitTestVisible="False"/>
                                <TextBlock x:Name="BlockServiceLabel" Text="BLOCK&#x0a;SERVICE"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontFamily="{StaticResource PrimaryFont}" FontSize="11" FontWeight="Bold"
                                           TextAlignment="Center" LineHeight="13"
                                           Foreground="{StaticResource IceTextBrush}" Opacity="0">
                                    <TextBlock.Effect>
                                        <DropShadowEffect x:Name="BlockServiceGlow" Color="#FFF6C2" BlurRadius="12" ShadowDepth="0" Opacity="0.8"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>
                </Border>

                <Ellipse Canvas.Left="80" Canvas.Top="10" Width="5" Height="5" Fill="#0A0A0B" Stroke="#6E6E66" StrokeThickness="0.5"/>

                <Rectangle x:Name="StatusBar" Canvas.Left="24" Canvas.Top="74" Width="120" Height="2" RadiusX="1" RadiusY="1"
                           Fill="#FFC400" Opacity="0.3"/>
            </Canvas>
        </Viewbox>
    </Grid>
</UserControl>
