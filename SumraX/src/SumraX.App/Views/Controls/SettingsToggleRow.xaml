<UserControl x:Class="SumraX.App.Views.Controls.SettingsToggleRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="12,10" MinHeight="40">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0"
                   Text="{Binding Title, ElementName=Root}"
                   FontFamily="{StaticResource PrimaryFont}"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   Margin="0,0,16,0"/>
        <CheckBox Grid.Column="1" Style="{StaticResource PremiumToggle}"
                  IsChecked="{Binding IsChecked, ElementName=Root, Mode=TwoWay}"
                  IsEnabled="{Binding IsEnabled, ElementName=Root}"
                  VerticalAlignment="Center"/>
    </Grid>
</UserControl>
