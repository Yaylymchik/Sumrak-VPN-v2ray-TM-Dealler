<UserControl x:Class="SumraX.App.Views.Controls.SumrakPowerButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Width="190" Height="190"
             ClipToBounds="True">
    <UserControl.Resources>
        <Storyboard x:Key="PulseRing" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="RingOuter" Storyboard.TargetProperty="Opacity"
                             From="0.35" To="0.7" Duration="0:0:1.2" AutoReverse="True"/>
        </Storyboard>
        <Storyboard x:Key="SpinRing" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="RingSpin" Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:2.4"/>
        </Storyboard>
    </UserControl.Resources>
    <Button Command="{Binding Command, ElementName=Root}"
            Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
            HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid Width="172" Height="172">
            <Ellipse x:Name="RingOuter" Width="168" Height="168" Stroke="#66FFD400" StrokeThickness="1.5" Opacity="0.4"/>
            <Ellipse Width="144" Height="144" Stroke="#99FFD400" StrokeThickness="2"/>
            <Ellipse Width="120" Height="120" Stroke="#FFD400" StrokeThickness="2.5" Opacity="0.85"/>
            <Ellipse x:Name="RingSpin" Width="152" Height="152" Stroke="#FFD400" StrokeThickness="2"
                     StrokeDashArray="12 28" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <RotateTransform Angle="0"/>
                </Ellipse.RenderTransform>
            </Ellipse>
            <Viewbox Width="58" Height="58">
                <Canvas Width="24" Height="24">
                    <Path Data="M12,3 C7.03,3 3,7.03 3,12 C3,16.97 7.03,21 12,21 C16.97,21 21,16.97 21,12 C21,7.03 16.97,3 12,3 Z M12,5 C15.87,5 19,8.13 19,12 C19,15.87 15.87,19 12,19 C8.13,19 5,15.87 5,12 C5,8.13 8.13,5 12,5 Z M11,7 L13,7 L13,13 L11,13 Z"
                          Fill="#FFD400"/>
                </Canvas>
            </Viewbox>
        </Grid>
    </Button>
</UserControl>