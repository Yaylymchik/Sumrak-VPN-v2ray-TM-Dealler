<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/sumrax_card_radius" />
            <solid android:color="@color/sumrax_nav_selected_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/sumrax_border_glow" />
        </shape>
    </item>
    <item
        android:width="3dp"
        android:gravity="start">
        <shape android:shape="rectangle">
            <corners
                android:bottomLeftRadius="@dimen/sumrax_card_radius"
                android:topLeftRadius="@dimen/sumrax_card_radius" />
            <solid android:color="@color/sumrax_success" />
        </shape>
    </item>
</layer-list>
