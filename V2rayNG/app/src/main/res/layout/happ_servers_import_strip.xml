<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_import_strip"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/padding_spacing_dp16"
    android:paddingEnd="@dimen/padding_spacing_dp16"
    android:paddingBottom="@dimen/padding_spacing_dp8"
    android:visibility="gone">

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/et_import_link"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_input"
        android:hint="@string/sumrax_import_hint"
        android:minHeight="40dp"
        android:padding="@dimen/padding_spacing_dp8"
        android:textColor="@color/sumrax_text_primary"
        android:textColorHint="@color/sumrax_text_tertiary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_spacing_dp8"
        android:gravity="end"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_paste_import"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_picker_action_btn"
            android:contentDescription="@string/sumrax_paste"
            android:padding="8dp"
            android:src="@drawable/ic_copy"
            app:tint="@color/sumrax_text_primary" />

        <ImageButton
            android:id="@+id/btn_import_link"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_picker_action_btn"
            android:contentDescription="@string/sumrax_import"
            android:padding="8dp"
            android:src="@drawable/ic_import_24dp"
            app:tint="@color/sumrax_accent" />

        <ImageButton
            android:id="@+id/btn_import_qr"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_picker_action_btn"
            android:contentDescription="@string/sumrax_import_qr"
            android:padding="8dp"
            android:src="@drawable/ic_scan_24dp"
            app:tint="@color/sumrax_text_primary" />
    </LinearLayout>
</LinearLayout>