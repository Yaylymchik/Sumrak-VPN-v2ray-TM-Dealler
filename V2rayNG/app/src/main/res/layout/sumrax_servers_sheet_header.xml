<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/padding_spacing_dp16"
    android:paddingTop="@dimen/padding_spacing_dp4"
    android:paddingEnd="@dimen/padding_spacing_dp8"
    android:paddingBottom="@dimen/padding_spacing_dp8">

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="sans-serif-medium"
        android:text="@string/jumpjump_servers_title"
        android:textColor="@color/sumrax_text_primary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <ImageButton
        android:id="@+id/btn_sheet_refresh"
        android:layout_width="@dimen/sumrax_icon_btn_size"
        android:layout_height="@dimen/sumrax_icon_btn_size"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/sumrax_refresh_subs"
        android:padding="6dp"
        android:src="@drawable/ic_refresh_24dp"
        app:tint="@color/sumrax_accent" />

    <ImageButton
        android:id="@+id/btn_sheet_test_all"
        android:layout_width="@dimen/sumrax_icon_btn_size"
        android:layout_height="@dimen/sumrax_icon_btn_size"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/sumrax_test_all"
        android:padding="6dp"
        android:src="@drawable/ic_speed_24dp"
        app:tint="@color/sumrax_accent" />

    <ImageButton
        android:id="@+id/btn_sheet_import"
        android:layout_width="@dimen/sumrax_icon_btn_size"
        android:layout_height="@dimen/sumrax_icon_btn_size"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/sumrax_import"
        android:padding="6dp"
        android:src="@drawable/ic_add_24dp"
        app:tint="@color/sumrax_text_primary" />

    <ImageButton
        android:id="@+id/btn_sheet_close"
        android:layout_width="@dimen/sumrax_icon_btn_size"
        android:layout_height="@dimen/sumrax_icon_btn_size"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/sumrax_picker_close"
        android:padding="6dp"
        android:src="@drawable/ic_close_24dp"
        app:tint="@color/sumrax_text_secondary" />

</LinearLayout>