<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settings_row_root"
    style="@style/Widget.Happ.SettingsForwardRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/happ_activity_horizontal_margin"
    android:paddingVertical="@dimen/padding_spacing_dp12">

    <TextView
        android:id="@+id/tv_settings_row_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/happ_text_primary"
        android:textSize="16sp"
        tools:text="Язык" />

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@null"
        android:padding="@dimen/padding_spacing_dp8"
        android:src="@drawable/ic_happ_arrow_forward" />

</LinearLayout>