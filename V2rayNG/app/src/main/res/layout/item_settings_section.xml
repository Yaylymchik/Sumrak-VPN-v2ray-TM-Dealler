<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settings_row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/padding_spacing_dp8"
    android:background="@drawable/bg_settings_row"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/padding_spacing_dp16"
    android:paddingTop="14dp"
    android:paddingEnd="@dimen/padding_spacing_dp16"
    android:paddingBottom="14dp">

    <TextView
        android:id="@+id/tv_settings_row_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/sumrax_text_primary"
        android:textSize="15sp"
        tools:text="Общие" />

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_chevron_right_24dp" />

</LinearLayout>
