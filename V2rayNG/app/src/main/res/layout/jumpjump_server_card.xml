<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_server_picker"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_jumpjump_server_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/padding_spacing_dp16"
    android:paddingTop="14dp"
    android:paddingEnd="@dimen/padding_spacing_dp16"
    android:paddingBottom="14dp">

    <TextView
        android:id="@+id/tv_server_flag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🌐"
        android:textSize="28sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/padding_spacing_dp16"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="@string/jumpjump_change_server"
            android:textColor="@color/sumrax_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_server_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/sumrax_no_server_selected"
            android:textColor="@color/sumrax_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_server_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:textColor="@color/sumrax_text_tertiary"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_server_ping"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/padding_spacing_dp8"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/sumrax_success"
        android:textSize="14sp"
        android:visibility="gone" />

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@string/jumpjump_change_server"
        android:src="@drawable/ic_arrow_drop_down"
        app:tint="@color/sumrax_text_secondary" />

</LinearLayout>
