<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/config_group_main"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="2dp"
    android:background="@drawable/bg_sumrax_group_card"
    android:paddingBottom="4dp">

    <ImageButton
        android:id="@+id/config_group_expand_collapse"
        android:layout_width="48dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_sumrax_text_on_main"
        android:contentDescription="@null"
        android:src="@drawable/ic_expand_less_24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/sumrax_ui_icon_primary" />

    <TextView
        android:id="@+id/config_group_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingTop="12dp"
        android:textColor="@color/sumrax_ui_text_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/config_group_refresh"
        app:layout_constraintStart_toEndOf="@id/config_group_expand_collapse"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Encrypted #1" />

    <TextView
        android:id="@+id/config_group_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingBottom="10dp"
        android:textColor="@color/sumrax_ui_text_tertiary"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="@id/config_group_name"
        app:layout_constraintStart_toStartOf="@id/config_group_name"
        app:layout_constraintTop_toBottomOf="@id/config_group_name"
        tools:text="21.11.2026 01:00" />

    <ImageButton
        android:id="@+id/config_group_refresh"
        android:layout_width="44dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_sumrax_text_on_main"
        android:contentDescription="@string/action_update_subscription"
        android:padding="10dp"
        android:src="@drawable/ic_refresh_24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/config_group_ping"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/sumrax_ui_icon_primary" />

    <ImageButton
        android:id="@+id/config_group_ping"
        android:layout_width="44dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_sumrax_text_on_main"
        android:contentDescription="@string/title_ping"
        android:padding="10dp"
        android:src="@drawable/ic_speed_24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/config_group_more"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/sumrax_ui_icon_primary" />

    <ImageButton
        android:id="@+id/config_group_more"
        android:layout_width="44dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_sumrax_text_on_main"
        android:contentDescription="@string/sumrax_nav_settings"
        android:padding="10dp"
        android:src="@drawable/ic_more_vert_24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/sumrax_ui_icon_primary" />
</androidx.constraintlayout.widget.ConstraintLayout>