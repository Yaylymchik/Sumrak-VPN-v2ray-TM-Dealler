<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item_picker_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_happ_text_on_main"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <View
        android:id="@+id/config_activated"
        android:layout_width="4dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_happ_selected_server"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_picker_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingVertical="12dp"
        android:textColor="@color/happ_text_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tv_picker_ping"
        app:layout_constraintStart_toEndOf="@id/config_activated"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="12dp"
        android:layout_marginStart="8dp"
        tools:text="Germany" />

    <TextView
        android:id="@+id/tv_picker_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/happ_text_tertiary"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/tv_picker_name"
        app:layout_constraintStart_toStartOf="@id/tv_picker_name"
        app:layout_constraintTop_toBottomOf="@id/tv_picker_name" />

    <TextView
        android:id="@+id/tv_picker_ping"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:paddingEnd="8dp"
        android:textColor="@color/happ_ping_ok"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_favorite"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="59 ms" />

    <ImageView
        android:id="@+id/btn_favorite"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/sumrax_picker_favorites"
        android:padding="8dp"
        android:src="@drawable/ic_star_border_24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_server_forward"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/happ_icon_primary" />

    <ImageView
        android:id="@+id/btn_server_forward"
        android:layout_width="40dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:padding="8dp"
        android:src="@drawable/ic_happ_arrow_forward"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iv_device_icon"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        tools:ignore="MissingConstraints" />

</androidx.constraintlayout.widget.ConstraintLayout>