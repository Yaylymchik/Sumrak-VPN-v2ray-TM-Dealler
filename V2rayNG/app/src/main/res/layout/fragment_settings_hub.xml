<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:paddingStart="@dimen/padding_spacing_dp16"
    android:paddingTop="@dimen/padding_spacing_dp8"
    android:paddingEnd="@dimen/padding_spacing_dp16"
    android:paddingBottom="@dimen/padding_spacing_dp16"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/padding_spacing_dp16"
            android:fontFamily="sans-serif-medium"
            android:text="@string/title_settings"
            android:textColor="@color/sumrax_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            style="@style/SumraX.NavSection"
            android:layout_marginTop="0dp"
            android:text="@string/sumrax_settings_section_interface" />

        <include
            android:id="@+id/row_ui"
            layout="@layout/item_settings_section" />

        <include
            android:id="@+id/row_language"
            layout="@layout/item_settings_section" />

        <TextView
            style="@style/SumraX.NavSection"
            android:text="@string/sumrax_settings_section_connection" />

        <include
            android:id="@+id/row_tun"
            layout="@layout/item_settings_section" />

        <include
            android:id="@+id/row_routing"
            layout="@layout/item_settings_section" />

        <include
            android:id="@+id/row_excluded_apps"
            layout="@layout/item_settings_section" />

        <include
            android:id="@+id/row_excluded_routes"
            layout="@layout/item_settings_section" />

        <include
            android:id="@+id/row_inbound"
            layout="@layout/item_settings_section" />

        <include
            android:id="@+id/row_connection_security"
            layout="@layout/item_settings_section" />

        <include
            android:id="@+id/row_ping"
            layout="@layout/item_settings_section" />

        <TextView
            style="@style/SumraX.NavSection"
            android:text="@string/sumrax_settings_section_data" />

        <include
            android:id="@+id/row_subscriptions"
            layout="@layout/item_settings_section" />

        <include
            android:id="@+id/row_geo_files"
            layout="@layout/item_settings_section" />

        <TextView
            style="@style/SumraX.NavSection"
            android:text="@string/sumrax_settings_section_xray" />

        <include
            android:id="@+id/row_advanced"
            layout="@layout/item_settings_section" />

        <include
            android:id="@+id/row_other"
            layout="@layout/item_settings_section" />

        <TextView
            style="@style/SumraX.NavSection"
            android:text="@string/sumrax_settings_section_system" />

        <include
            android:id="@+id/row_logs"
            layout="@layout/item_settings_section" />

        <include
            android:id="@+id/row_logs_view"
            layout="@layout/item_settings_section" />

        <include
            android:id="@+id/row_statistics"
            layout="@layout/item_settings_section" />

        <include
            android:id="@+id/row_diagnostics"
            layout="@layout/item_settings_section" />

        <include
            android:id="@+id/row_backup"
            layout="@layout/item_settings_section" />

        <include
            android:id="@+id/row_reset"
            layout="@layout/item_settings_section" />

        <include
            android:id="@+id/row_faq"
            layout="@layout/item_settings_section" />

        <include
            android:id="@+id/row_report"
            layout="@layout/item_settings_section" />

        <LinearLayout
            android:id="@+id/about_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_spacing_dp16"
            android:background="@drawable/bg_glass_panel"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:orientation="vertical"
            android:padding="@dimen/padding_spacing_dp16">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="@string/sumrax_about_label"
                android:textColor="@color/sumrax_accent"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_spacing_dp8"
                android:fontFamily="sans-serif-medium"
                android:text="@string/sumrax_about_app_name"
                android:textColor="@color/sumrax_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_about_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:textColor="@color/sumrax_text_tertiary"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_spacing_dp16"
                android:fontFamily="monospace"
                android:text="@string/sumrax_nav_coder"
                android:textColor="@color/sumrax_text_tertiary"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:text="@string/sumrax_coder_name"
                android:textColor="@color/sumrax_success"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
