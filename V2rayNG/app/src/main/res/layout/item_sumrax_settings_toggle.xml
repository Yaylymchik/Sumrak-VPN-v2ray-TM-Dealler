<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sumrax_text_on_main"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/sumrax_ui_activity_horizontal_margin"
    android:paddingVertical="10dp">

    <TextView
        android:id="@+id/tv_toggle_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/sumrax_ui_text_primary"
        android:textSize="16sp"
        tools:text="Fragmentation" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switch_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:thumbTint="@color/sumrax_settings_switch_thumb"
        app:trackTint="@color/sumrax_settings_switch_track" />
</LinearLayout>