<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:padding="@dimen/padding_spacing_dp16"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="@string/sumrax_reset_description"
            android:textColor="@color/sumrax_text_secondary"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reset_user_settings"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_spacing_dp16"
            android:background="@drawable/bg_settings_row"
            android:fontFamily="sans-serif-medium"
            android:gravity="start|center_vertical"
            android:minHeight="52dp"
            android:paddingStart="@dimen/padding_spacing_dp16"
            android:paddingEnd="@dimen/padding_spacing_dp16"
            android:text="@string/sumrax_reset_user_settings"
            android:textAllCaps="false"
            android:textColor="@color/sumrax_text_primary"
            app:backgroundTint="@android:color/transparent"
            app:rippleColor="@color/sumrax_green_alpha_33" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif"
            android:paddingStart="@dimen/padding_spacing_dp16"
            android:paddingEnd="@dimen/padding_spacing_dp16"
            android:text="@string/sumrax_reset_user_settings_description"
            android:textColor="@color/sumrax_text_tertiary"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reset_routing"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_spacing_dp16"
            android:background="@drawable/bg_settings_row"
            android:fontFamily="sans-serif-medium"
            android:gravity="start|center_vertical"
            android:minHeight="52dp"
            android:paddingStart="@dimen/padding_spacing_dp16"
            android:paddingEnd="@dimen/padding_spacing_dp16"
            android:text="@string/sumrax_reset_routing"
            android:textAllCaps="false"
            android:textColor="@color/sumrax_text_primary"
            app:backgroundTint="@android:color/transparent"
            app:rippleColor="@color/sumrax_green_alpha_33" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reset_traffic"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_spacing_dp8"
            android:background="@drawable/bg_settings_row"
            android:fontFamily="sans-serif-medium"
            android:gravity="start|center_vertical"
            android:minHeight="52dp"
            android:paddingStart="@dimen/padding_spacing_dp16"
            android:paddingEnd="@dimen/padding_spacing_dp16"
            android:text="@string/sumrax_reset_traffic"
            android:textAllCaps="false"
            android:textColor="@color/sumrax_text_primary"
            app:backgroundTint="@android:color/transparent"
            app:rippleColor="@color/sumrax_green_alpha_33" />

    </LinearLayout>
</ScrollView>
