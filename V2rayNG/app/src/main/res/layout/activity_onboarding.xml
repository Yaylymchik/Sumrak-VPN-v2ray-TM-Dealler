<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sumrax_bg"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_step"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:textColor="@color/sumrax_text_tertiary"
            android:textSize="13sp"
            tools:text="1 / 3" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:textColor="@color/sumrax_text_primary"
            android:textSize="26sp"
            android:textStyle="bold"
            tools:text="Add subscription" />

        <TextView
            android:id="@+id/tv_body"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:lineSpacingMultiplier="1.25"
            android:textColor="@color/sumrax_text_secondary"
            android:textSize="16sp"
            tools:text="Paste your subscription link…" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_primary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:textAllCaps="false"
            tools:text="Next" />

        <TextView
            android:id="@+id/btn_skip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:padding="12dp"
            android:text="@string/sumrax_onboarding_skip"
            android:textColor="@color/sumrax_text_tertiary"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
