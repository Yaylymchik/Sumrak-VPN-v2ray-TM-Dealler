<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_spacing_dp16">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/vpn_hotspot_intro"
            android:textAppearance="@style/TextAppearance.AppCompat.Body1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_spacing_dp16"
            android:text="@string/vpn_hotspot_section_noroot"
            android:textAppearance="@style/TextAppearance.AppCompat.Title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_spacing_dp4"
            android:text="@string/vpn_hotspot_noroot_intro"
            android:textAppearance="@style/TextAppearance.AppCompat.Body2" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_proxy_sharing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_spacing_dp8"
            android:text="@string/title_pref_proxy_sharing_enabled" />

        <TextView
            android:id="@+id/tv_noroot_proxy_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_spacing_dp4"
            android:fontFamily="monospace"
            android:textAppearance="@style/TextAppearance.AppCompat.Caption" />

        <ImageView
            android:id="@+id/iv_proxy_qr"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/padding_spacing_dp12"
            android:contentDescription="@string/vpn_hotspot_noroot_qr_content_desc"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_copy_proxy"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_spacing_dp8"
            android:text="@string/vpn_hotspot_noroot_copy" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reconnect_vpn"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_spacing_dp4"
            android:text="@string/vpn_hotspot_noroot_reconnect"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_noroot_limits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_spacing_dp8"
            android:text="@string/vpn_hotspot_noroot_limits"
            android:textAppearance="@style/TextAppearance.AppCompat.Caption" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_spacing_dp12"
            android:text="@string/vpn_hotspot_shizuku_title"
            android:textAppearance="@style/TextAppearance.AppCompat.Subhead" />

        <TextView
            android:id="@+id/tv_shizuku_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_spacing_dp4"
            android:textAppearance="@style/TextAppearance.AppCompat.Body2" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_install_shizuku"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vpn_hotspot_shizuku_install" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_shizuku_docs"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vpn_hotspot_shizuku_docs" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/padding_spacing_dp16"
            android:layout_marginBottom="@dimen/padding_spacing_dp8"
            android:background="?android:attr/listDivider" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/vpn_hotspot_section_root"
            android:textAppearance="@style/TextAppearance.AppCompat.Title" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_spacing_dp8"
            android:fontFamily="monospace"
            android:textAppearance="@style/TextAppearance.AppCompat.Subhead" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_install_companion"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_spacing_dp12"
            android:text="@string/vpn_hotspot_install_companion" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_open_companion"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_spacing_dp8"
            android:text="@string/vpn_hotspot_open_companion" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_lan_sharing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_spacing_dp12"
            android:text="@string/title_root_lan_sharing" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_spacing_dp4"
            android:text="@string/summary_root_lan_sharing"
            android:textAppearance="@style/TextAppearance.AppCompat.Caption" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_system_hotspot"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_spacing_dp12"
            android:text="@string/vpn_hotspot_system_tether" />

        <TextView
            android:id="@+id/tv_steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_spacing_dp12"
            android:textAppearance="@style/TextAppearance.AppCompat.Body2" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_upstream_source"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_spacing_dp8"
            android:text="@string/vpn_hotspot_upstream" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_spacing_dp8"
            android:text="@string/vpn_hotspot_gpl_notice"
            android:textAppearance="@style/TextAppearance.AppCompat.Caption" />
    </LinearLayout>
</ScrollView>