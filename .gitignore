# Ignore data and key store files
*.dat
*.jks

# Ignore output JSON file
V2rayNG/app/release/output.json

# Ignore IDE and build system directories
.idea/
.gradle/
*.iml

# Ignore local properties and DS_Store files
/local.properties
.DS_Store

# Ignore build directories and captures
/build
/captures
V2rayNG/app/build
V2rayNG/build
V2rayNG/local.properties

# Ignore APK and AAR files (keep app native/core libs)
*.apk
*.aar
!V2rayNG/app/src/main/assets/bundled/vpn-hotspot-3.0.8.apk
!V2rayNG/app/libs/**

# Ignore signing properties
signing.properties
V2rayNG/gradle.properties
fastlane/play-store-credentials.json
fastlane/report.xml

# Ignore shared object files (keep bundled jni if present)
*.so
!V2rayNG/app/libs/**
!V2rayNG/app/src/main/jniLibs/**/liberror-code.so

# Ignore Google services JSON
V2rayNG/app/google-services.json

# Local reference dumps (not part of SumraX)
hiddify-app-main/
hiddify-app-main.zip
*.zip

# Additional common Android/Java ignores
*.log
*.tmp
*.bak
*.swp
*.orig
*.class
*.jar
!**/gradle/wrapper/gradle-wrapper.jar
*.war
*.ear

# Ignore executable files
*.exe
*.dll
*.obj
*.o
*.pyc
*.pyo

# Ignore files from other IDEs
.vscode/
.classpath
.project
.settings/
*.sublime-workspace
*.sublime-project

# Ignore OS-specific files
Thumbs.db
.DS_Store

# Local UI compare captures (may reference third-party packages in dumps)
compare_full_*/
compare_ui_*/
compare_ui_desktop_apk_*/
compare_ui_recheck_*/

# Local analysis dumps (jadx / reference APK unpack) — not for publish
tools/

# Local build cache and credentials (never commit)
.build-cache/
.git-cred-temp.txt
**/play-signing.local.txt

